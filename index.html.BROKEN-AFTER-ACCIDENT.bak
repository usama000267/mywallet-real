            
                            `
                            <div class="data-row">
                                <span>Sale Price</span>
                                <strong>${money(salePrice)}</strong>
                            </div>
                            `
                            ? `
                            <div class="data-row">
                                <span>Sale Price</span>
                                <strong>${money(salePrice)}</strong>
                            </div>
                            `
                            : ""
                        }
                            `
                            <div class="data-row">
                                <span>Realized Profit</span>
                                <strong style="color:${profit >= 0 ? "var(--green)" : "var(--red)"}">
                                    ${money(profit)}
                                </strong>
                            </div>
                            `
                            :
                            ""
                        }


                        ${
                            status === "owned"
            
                            `<button
    class="btn btn-primary"
    style="margin-top:7px;"
    onclick="openSellModal(
        ${Number(nft.id)},
        '${escapeHtml(name).replace(/'/g,"&#039;")}',
        ${purchasePrice},
        '${escapeHtml(image).replace(/'/g,"&#039;")}',
        ${Number(nft.expected_profit_percent || nft.profit_percent || 0)}
    )"
>
    Sell NFT
                           
                            </button>
                            `
                            :
                            ""
                        }

                    </div>

                </div>

            </div>

        `;

    }).join("");

}


/* =========================================================
   SELL NFT
========================================================= */

async function loadSellHistoryRecords(){

    const container =
        document.getElementById("sellHistoryRecords");

    if(!container){
        return;
    }

    try{

        const data =
            await api("/api/history");

        let sales =
            Array.isArray(data.nftSales)
 data.nftSales
            : [];

        if(!sales.length){

            container.innerHTML = `
                <div class="sell-history-empty">
                    No NFT sales yet.
                </div>
            `;

            return;
        }

        container.innerHTML =
            sales.map(item => {

                const purchase =
                    Number(
                        item.purchase_price ||
                        item.amount ||
                        0
                    );

                const sale =
                    Number(
                        item.sale_price ||
                        item.amount ||
                        0
                    );

                const profit =
                    Number(
                        item.profit_amount ||
                        0
                    );

                const date =
                    item.created_at
    
                    new Date(
                        item.created_at
                    ).toLocaleString(
                        undefined,
                        {
                            year:"numeric",
                            month:"short",
                            day:"numeric",
                            hour:"2-digit",
                            minute:"2-digit"
                        }
                    )
                    :
                    "-";

                const nftName =
                    item.nft_name ||
                    item.name ||
                    "NFT";

                return `

                    <div class="sell-history-record">

                        <div class="sell-history-main">

                            <div class="sell-history-nft">
                                ${escapeHtml(nftName)}
                            </div>

                            <div class="sell-history-date">
                                ${escapeHtml(date)}
                            </div>

                            <div class="sell-history-values">

                                <span class="sell-value">
                                    Bought $${purchase.toFixed(2)}
                                </span>

                                <span class="sell-value sale">
                                    Sold $${sale.toFixed(2)}
                                </span>

                                <span class="sell-value profit">
                                    Profit +$${profit.toFixed(2)}
                                </span>

                            </div>

                        </div>

                        <div class="sell-history-profit">

                            <span class="sell-history-profit-label">
                                Profit
                            </span>

                            <span class="sell-history-profit-amount">
                                +$${profit.toFixed(2)}
                            </span>

                        </div>

                    </div>

                `;

            }).join("");

    }catch(error){

        console.error(
            "SELL HISTORY ERROR:",
            error
        );

        container.innerHTML = `
            <div class="sell-history-empty">
                Unable to load sales records.
            </div>
        `;
    }
}

async function loadSellNFTs(){

    const container =
        document.getElementById("sellNFTContainer");


    container.innerHTML = `
        <div class="empty" style="grid-column:1/-1;">
            Loading...
        </div>
    `;


    try{

        const data = await api("/api/my-nfts");

        let nfts =
            data.nfts ||
            data.userNFTs ||
            data.data ||
            data;


        if(!Array.isArray(nfts)){
            nfts = [];
        }


        nfts =
            nfts.filter(nft =>
                String(nft.status || "").toLowerCase() === "owned"
            );


        if(!nfts.length){

            container.innerHTML = `
                <div class="card empty" style="grid-column:1/-1;">
                    <div class="empty-icon"></div>
                    <strong>No NFTs available for sale.</strong>
                    <p style="margin-top:7px;">
                        Purchase an NFT first.
                    </p>
                </div>
            `;

            return;
        }


        container.innerHTML = nfts.map(nft=>{

            const image =
                nft.image_url ||
                nft.imageUrl ||
                "";


            const price =
                Number(nft.purchase_price || 0);


            return `

                <div class="card my-nft-card">

                    <div class="my-nft-row">

                        <div class="my-nft-thumb">

                            ${image ? `<img
                                    src="${escapeHtml(image)}"
                                    alt="${escapeHtml(nft.name || "NFT")}"
                                >`
                                :
                                `<div style="
                                    width:100%;
                                    height:100%;
                                    display:flex;
                                    align-items:center;
                                    justify-content:center;
                                    font-size:40px;
                                ">Image</div>`
                            }

                        </div>


                        <div class="my-nft-info">

                            <div class="nft-name">
                                ${escapeHtml(nft.name || "NFT")}
                            </div>

                            <div class="data-row">
                                <span>Purchase Price</span>
                                <strong>${money(price)}</strong>
                            </div>

                            <div class="data-row">
                                <span>Purchased</span>
                                <strong>${formatDate(nft.purchase_date)}</strong>
                            </div>

                            <button
                                class="btn btn-primary"
                                onclick="openSellModal(
                                    ${Number(nft.id)},
                                    '${escapeHtml(nft.name || "NFT").replace(/'/g,"&#039;")}',
                                    ${price},
                                    '${escapeHtml(image).replace(/'/g,"&#039;")}'
                                )"
                            >
                                Sell NFT
                            </button>

                        </div>

                    </div>

                </div>

            `;

        }).join("");


    }catch(error){

        container.innerHTML = `
            <div class="empty" style="grid-column:1/-1;">
                Unable to load NFTs.
            </div>
        `;

        showToast(error.message,"error");

    }

}


function openSellModal(id,name,purchasePrice,image,profitPercent){

    selectedSellNFT = {
        id,
        name,
        purchasePrice,
        image,
        profitPercent
    };

    document.getElementById("sellNFTDetails").innerHTML = `

        <div style="display:flex;gap:15px;align-items:center;">

            <div style="
                width:80px;
                height:80px;
                border-radius:13px;
                overflow:hidden;
                background:#eeeaff;
                display:flex;
                align-items:center;
                justify-content:center;
                flex-shrink:0;
            ">

                ${image ? `<img
                        src="${escapeHtml(image)}"
                        style="width:100%;height:100%;object-fit:cover;"
                    >`
                    :
                    `<span style="font-size:32px;">NFT</span>`
                }

            </div>

            <div>

                <div style="font-size:17px;font-weight:850;">
                    ${escapeHtml(name)}
                </div>

                <div style="font-size:13px;color:#777;margin-top:5px;">
                    Purchase price: ${money(purchasePrice)}
                </div>

            </div>

        </div>

    `;

    updateSellCalculation();

    document.getElementById("sellModal").classList.add("show");

    document.getElementById("confirmSellBtn").onclick =
        confirmSellNFT;
}


function closeSellModal(){

    document.getElementById("sellModal").classList.remove("show");

    selectedSellNFT = null;

}


function updateSellCalculation(){

    if(!selectedSellNFT){
        return;
    }

    const purchasePrice =
        Number(selectedSellNFT.purchasePrice || 0);

    const profitPercent =
        Number(selectedSellNFT.profitPercent || 0);

    const profit =
        purchasePrice * profitPercent / 100;

    const salePrice =
        purchasePrice + profit;

    document.getElementById("sellCalculation").innerHTML = `

        Purchase Price:
        <strong>${money(purchasePrice)}</strong>
        <br>

        Admin Profit:
        <strong>${profitPercent}%</strong>
        <br>

        Profit Amount:
        <strong style="color:var(--green)">
            ${money(profit)}
        </strong>
        <br>

        Automatic Sale Price:
        <strong style="color:var(--green)">
            ${money(salePrice)}
        </strong>

    `;

}


async function confirmSellNFT(){

    if(!selectedSellNFT){
        return;
    }

    const button =
        document.getElementById("confirmSellBtn");

    button.disabled = true;
    button.textContent = "Selling...";

    try{

        const data = await api(
            "/api/my-nfts/" +
            Number(selectedSellNFT.id) +
            "/sell",
            {
                method:"POST",
                body:JSON.stringify({})
            }
        );

        if(data.success === false){

            throw new Error(
                data.message || "NFT sale failed."
            );

        }

        closeSellModal();

        showToast(
            "NFT sold successfully.",
            "success"
        );

        await loadDashboard();
        await loadMyNFTs();
        await loadSellNFTs();
        await loadHistory();

        openPage("my-nfts");

    }catch(error){

        showToast(error.message,"error");

    }finally{

        button.disabled = false;
        button.textContent = "Sell NFT";

    }

}

/* =========================================================
   DEPOSIT
========================================================= */

function selectDepositNetwork(network){

    selectedDepositNetwork = network;


    document
        .getElementById("depositBep20")
        .classList.toggle(
            "selected",
            network === "BEP20"
        );


    document
        .getElementById("depositTrc20")
        .classList.toggle(
            "selected",
            network === "TRC20"
        );


    updateDepositAddress();

}


async function copyDepositAddress(){

    const input =
        document.getElementById("depositAddress");


    const value = input.value;


    if(!value || value === "Loading..." || value === "Address not configured"){

        showToast(
            "Deposit address is not available.",
            "error"
        );

        return;
    }


    try{

        await navigator.clipboard.writeText(value);

        showToast(
            "Copy Successful! Deposit address copied to clipboard.",
            "success"
        );

    }catch{

        input.select();

        document.execCommand("copy");

        showToast(
            "Copy Successful! Deposit address copied to clipboard.",
            "success"
        );

    }

}


document.getElementById("depositForm").addEventListener(
    "submit",
    async function(e){

        e.preventDefault();


        const amount =
            Number(
                document.getElementById("depositAmount").value
            );


        const txHash =
            document.getElementById("depositTxHash").value.trim();


        if(!amount || amount <= 0){

            showToast(
                "Enter a valid deposit amount.",
                "error"
            );

            return;
        }


        if(!txHash){

            showToast(
                "Enter the transaction hash.",
                "error"
            );

            return;
        }


        const button =
            this.querySelector("button[type=submit]");


        const oldText = button.textContent;

        button.disabled = true;
        button.textContent = "Submitting...";


        try{

            const data = await api("/api/deposits",{

                method:"POST",

                body:JSON.stringify({

                    amount,
                    network:selectedDepositNetwork,
                    txHash

                })

            });


            if(data.success === false){

                throw new Error(
                    data.message || "Deposit request failed."
                );

            }


            showToast(
                data.message ||
                "Deposit request submitted successfully.",
                "success"
            );


            document.getElementById("depositAmount").value = "";

            document.getElementById("depositTxHash").value = "";


            await loadHistory();


        }catch(error){

            showToast(
                error.message,
                "error"
            );

        }finally{

            button.disabled = false;
            button.textContent = oldText;

        }

    }
);


/* =========================================================
   WITHDRAW
========================================================= */

function selectWithdrawNetwork(network){

    selectedWithdrawNetwork = network;


    document
        .getElementById("withdrawBep20")
        .classList.toggle(
            "selected",
            network === "BEP20"
        );


    document
        .getElementById("withdrawTrc20")
        .classList.toggle(
            "selected",
            network === "TRC20"
        );

}
function startWithdrawOtpCountdown(){

    const button =
        document.getElementById("sendWithdrawOtpBtn");

    if(!button){
        return;
    }

    let seconds = 60;

    button.disabled = true;
    button.textContent = "Resend  60s";

    clearInterval(
        window.withdrawOtpTimer
    );

    window.withdrawOtpTimer =
        setInterval(function(){

            seconds--;

            if(seconds > 0){

                button.textContent =
                    `Resend  ${seconds}s`;

            }else{

                clearInterval(
                    window.withdrawOtpTimer
                );

                window.withdrawOtpTimer = null;

                button.disabled = false;
                button.textContent = "Resend OTP";

            }

        },1000);

}
async function sendWithdrawOTP(){

    const button =
        document.getElementById("sendWithdrawOtpBtn");

    const message =
        document.getElementById("withdrawOtpMessage");

    if(!button){
        return;
    }

    const oldText =
        button.textContent;

    button.disabled = true;
    button.textContent = "Sending...";

    if(message){
        message.textContent = "";
    }

    try{

        const data =
            await api(
                "/api/withdrawals/send-otp",
                {
                    method:"POST"
                }
            );

        if(data.success === false){

            throw new Error(
                data.message ||
                "Unable to send OTP."
            );

        }

        if(message){

            message.textContent =
                data.message ||
                "OTP sent to your email.";

            message.style.color =
                "#16a34a";

        }

        showToast(
            data.message ||
            "Withdrawal OTP sent.",
            "success"
        );

startWithdrawOtpCountdown();
        


    }catch(error){

        if(message){

            message.textContent =
                error.message ||
                "Unable to send OTP.";

            message.style.color =
                "#dc2626";

        }

        showToast(
            error.message ||
            "Unable to send OTP.",
            "error"
        );


        button.disabled = false;
        button.textContent = oldText;

    }

}

document.getElementById("withdrawForm").addEventListener(
    "submit",
    async function(e){

        e.preventDefault();
e.stopImmediatePropagation();
        const amount =
            Number(
                document.getElementById("withdrawAmount").value
            );

        const walletAddress =
            document
                .getElementById("withdrawWalletAddress")
                .value
                .trim();

        const otp =
            document
                .getElementById("withdrawOtp")
                .value
                .trim();

        const currentBalance =
            Number(
                currentUser?.balance || 0
            );

        if(!amount || amount <= 0){
            showToast(
                "Enter a valid withdrawal amount.",
                "error"
            );
            return;
        }

        if(amount > currentBalance){
            showToast(
                "Insufficient balance.",
                "error"
            );
            return;
        }

        if(!walletAddress){
            showToast(
                "Enter your wallet address.",
                "error"
            );
            return;
        }

        if(!/^\d{6}$/.test(otp)){
            showToast(
                "Enter the 6-digit withdrawal OTP.",
                "error"
            );
            return;
        }

        const button =
            this.querySelector(
                "button[type=submit]"
            );

        const oldText =
            button.textContent;

        button.disabled = true;
        button.textContent = "Submitting...";

        try{

            const data =
                await api(
                    "/api/withdrawals",
                    {
                        method:"POST",

                        body:JSON.stringify({
                            amount,
                            network:selectedWithdrawNetwork,
                            walletAddress,
                            otp
                        })
                    }
                );

            if(data.success === false){
                throw new Error(
                    data.message ||
                    "Withdrawal request failed."
                );
            }

            showToast(
                data.message ||
                "Withdrawal request submitted successfully.",
                "success"
            );

            document.getElementById(
                "withdrawAmount"
            ).value = "";

            document.getElementById(
                "withdrawWalletAddress"
            ).value = "";

            document.getElementById(
                "withdrawOtp"
            ).value = "";

            await loadDashboard();
            await loadHistory();

        }catch(error){

            showToast(
                error.message ||
                "Withdrawal request failed.",
                "error"
            );

        }finally{

            button.disabled = false;
            button.textContent = oldText;

        }

    }
);

/* =========================================================
   HISTORY
========================================================= */

async function loadHistory(){

    const tbody =
        document.getElementById("historyTableBody");


    tbody.innerHTML = `
        <tr>
            <td colspan="5" style="text-align:center;">
                Loading history...
            </td>
        </tr>
    `;


    try{

        const data = await api("/api/history");


        let deposits =
            Array.isArray(data.deposits)

            data.deposits
            :
            [];


        let withdrawals =
            Array.isArray(data.withdrawals)

            data.withdrawals
            :
            [];


        let earnings =
            Array.isArray(data.earnings)

            data.earnings
            :
            [];
let nftPurchases =
    Array.isArray(data.nftPurchases)
    ? data.nftPurchases
    : [];

let nftSales =
    Array.isArray(data.nftSales)
    ? data.nftSales
    : [];

        const rows = [];


        deposits.forEach(item=>{

            rows.push({

                date:item.created_at,

                type:"Deposit",

                network:item.network || "-",

                amount:Number(item.amount || 0),

                status:item.status || "pending"

            });

        });


        withdrawals.forEach(item=>{

            rows.push({

                date:item.created_at,

                type:"Withdrawal",

                network:item.network || "-",

                amount:Number(item.amount || 0),

                status:item.status || "pending"

            });

        });


        earnings.forEach(item=>{

            rows.push({

                date:item.created_at,

                type:
                    item.type ||
                    "Earning",

                network:"-",

                amount:Number(item.amount || 0),

                description:
                    item.description || "",

                status:item.status || "completed"
                 });
         });
nftPurchases.forEach(item=>{
    rows.push({
        date:item.created_at,
        type:"NFT Purchase",
        network:"-",
        amount:Number(item.amount || 0),
        status:"completed"
    });
});

nftSales.forEach(item=>{
    rows.push({
        date:item.created_at,
        type:"NFT Sale",
        network:"-",
        amount:Number(item.amount || 0),
        status:"completed"
    });
});
        rows.sort((a,b)=>{

            return new Date(b.date) - new Date(a.date);

        });


        if(!rows.length){

            tbody.innerHTML = `
                <tr>
                    <td colspan="5" style="text-align:center;padding:40px;">
                        No transaction history yet.
                    </td>
                </tr>
            `;

            return;
        }


        tbody.innerHTML = rows.map(item=>{

            const status =
                String(item.status).toLowerCase();


            let badgeClass = "badge-yellow";


            if(
                status === "approved" ||
                status === "completed"
            ){
                badgeClass = "badge-green";
            }


            if(status === "rejected"){
                badgeClass = "badge-red";
            }


            const typeName =
                String(item.type)
                    .replaceAll("_"," ")
                    .replace(/\b\w/g,c=>c.toUpperCase());


            return `

                <tr>

                    <td>
                        ${formatDate(item.date)}
                    </td>

                    <td>
                        <strong>
                            ${escapeHtml(typeName)}
                            ${item.description ? `<div style="font-size:12px;opacity:.75;margin-top:4px;">${escapeHtml(item.description)}</div>` : ""}
                        </strong>

                    </td>
                    <td>
                    </td>

                    <td>
                        ${money(item.amount)}
                    </td>

                    <td>
                        <span class="badge ${status === "owned" ? "badge-green" : "badge-yellow"}">
                            ${escapeHtml(status)}
                        </span>
                    </td>

                </tr>

            `;

        }).join("");


    }catch(error){

        tbody.innerHTML = `
            <tr>
                <td colspan="5" style="text-align:center;padding:40px;">
                    Unable to load history.
                </td>
            </tr>
        `;

        console.error(error);

    }

}

/* =========================================================
   REFERRAL
========================================================= */
async function loadReferral(){

    try{

        const data = await api("/api/referral");

        document.getElementById("referralCode").textContent =
            data.referralCode || "-";

        document.getElementById("referralLink").value =
            data.referralLink || "";

        document.getElementById("referralPercent").textContent =
            Number(data.bonusPercent || 10) + "%";

        document.getElementById("teamCount").textContent =
            data.teamCount || 0;

        document.getElementById("totalReferralBonus").textContent =
            money(data.totalBonus || 0);

        document.getElementById("profileReferral").textContent =
            data.referralCode || "-";


        const historyBox =
            document.getElementById("referralHistory");


        if(historyBox){

            if(!data.team || data.team.length === 0){

                historyBox.innerHTML = `
                    <div style="
                        text-align:center;
                        color:#777;
                        padding:24px 12px;
                        font-size:13px;
                    ">
                        No referral members yet.
                    </div>
                `;

            }else{

                historyBox.innerHTML = `

                    <div style="
                        display:grid;
                        grid-template-columns:
                            1.05fr 1.45fr .9fr .9fr;
                        gap:8px;
                        align-items:center;
                        padding:12px 10px;
                        background:#f8f9fb;
                        border-bottom:1px solid #e8e8e8;
                        font-size:11px;
                        font-weight:700;
                        color:#888;
                        text-transform:uppercase;
                    ">

                        <div>Name</div>
                        <div>Email</div>
                        <div>Balance</div>
                        <div>Joined</div>

                    </div>


                   ${data.team.map(user => {

    const level =
        Number(user.level || 1);

    const teamCount =
        Number(user.total_team_count || 0);

    const isDirect =
        level === 1;

    return `

        <div style="
            position:relative;
            margin:10px 0;
            padding:16px;
            border:1px solid ${
                isDirect
     "rgba(124,58,237,.16)"
                    : "rgba(6,182,212,.16)"
            };
            border-radius:18px;
            background:
                linear-gradient(
                    135deg,
                    ${
                        isDirect
             "rgba(124,58,237,.055)"
                            : "rgba(6,182,212,.045)"
                    },
                    #ffffff
                );
            box-shadow:
                0 8px 25px rgba(15,23,42,.055);
            overflow:hidden;
        ">

            <div style="
                display:flex;
                justify-content:space-between;
                align-items:flex-start;
                gap:12px;
            ">

                <div style="
                    display:flex;
                    align-items:center;
                    gap:12px;
                    min-width:0;
                ">

                    <div style="
                        width:44px;
                        height:44px;
                        min-width:44px;
                        border-radius:14px;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        background:
                            ${
                                isDirect
                     "linear-gradient(135deg,#7c3aed,#a855f7)"
                                    : "linear-gradient(135deg,#06b6d4,#3b82f6)"
                            };
                        color:#fff;
                        font-size:20px;
                        box-shadow:
                            0 7px 18px
                            ${
                                isDirect
                     "rgba(124,58,237,.22)"
                                    : "rgba(6,182,212,.20)"
                            };
                    ">
                        ${isDirect ? "??" : "??"}
                    </div>


                    <div style="
                        min-width:0;
                    ">

                        <div style="
                            display:flex;
                            align-items:center;
                            gap:7px;
                            flex-wrap:wrap;
                        ">

                            <div style="
                                font-size:14px;
                                font-weight:800;
                                color:#17142b;
                                overflow:hidden;
                                text-overflow:ellipsis;
                                white-space:nowrap;
                                max-width:180px;
                            ">
                                ${user.name || "-"}
                            </div>


                            <span style="
                                display:inline-flex;
                                align-items:center;
                                padding:4px 8px;
                                border-radius:999px;
                                font-size:10px;
                                font-weight:800;
                                letter-spacing:.3px;
                                color:#fff;
                                background:
                                    ${
                                        isDirect
                             "linear-gradient(135deg,#7c3aed,#9333ea)"
                                            : "linear-gradient(135deg,#0891b2,#2563eb)"
                                    };
                            ">
                                ${
                                    isDirect
                         "LEVEL 1  DIRECT"
                                        : `LEVEL ${level}  INDIRECT`
                                }
                            </span>

                        </div>


                        <div style="
                            margin-top:4px;
                            color:#777;
                            font-size:11px;
                            overflow:hidden;
                            text-overflow:ellipsis;
                            white-space:nowrap;
                        ">
                            ${user.email || "-"}
                        </div>

                    </div>

                </div>


                <div style="
                    text-align:right;
                    min-width:75px;
                ">

                    <div style="
                        color:#777;
                        font-size:10px;
                        font-weight:700;
                        text-transform:uppercase;
                        letter-spacing:.5px;
                    ">
                        Balance
                    </div>

                    <div style="
                        margin-top:3px;
                        color:#17142b;
                        font-size:13px;
                        font-weight:850;
                        white-space:nowrap;
                    ">
                        ${money(user.balance || 0)}
                    </div>

                </div>

            </div>


            <div style="
                display:flex;
                flex-wrap:wrap;
                gap:8px;
                margin-top:14px;
                padding-top:12px;
                border-top:1px solid rgba(15,23,42,.07);
            ">

                <div style="
                    flex:1;
                    min-width:120px;
                    padding:9px 11px;
                    border-radius:12px;
                    background:rgba(255,255,255,.75);
                    border:1px solid rgba(15,23,42,.06);
                ">

                    <div style="
                        color:#888;
                        font-size:9px;
                        font-weight:800;
                        text-transform:uppercase;
                        letter-spacing:.5px;
                    ">
                        Team Size
                    </div>

                    <div style="
                        margin-top:3px;
                        color:#17142b;
                        font-size:13px;
                        font-weight:850;
                    ">
                        ${teamCount}
                        ${
                            teamCount === 1
                 " member"
                                : " members"
                        }
                    </div>

                </div>


                <div style="
                    flex:1;
                    min-width:120px;
                    padding:9px 11px;
                    border-radius:12px;
                    background:rgba(255,255,255,.75);
                    border:1px solid rgba(15,23,42,.06);
                ">

                    <div style="
                        color:#888;
                        font-size:9px;
                        font-weight:800;
                        text-transform:uppercase;
                        letter-spacing:.5px;
                    ">
                        Joined
                    </div>

                    <div style="
                        margin-top:3px;
                        color:#17142b;
                        font-size:12px;
                        font-weight:750;
                        white-space:nowrap;
                    ">
                        ${
                            user.created_at
                 new Date(
                                    user.created_at
                                ).toLocaleDateString()
                                : "-"
                        }
                    </div>

                </div>

            </div>

        </div>

    `;

}).join("")}
                `;

            }

        }


   

    }catch(error){

        console.error(
            "Referral:",
            error
        );

    }

}
/* =========================================================
   COPY REFERRAL LINK
========================================================= */
async function copyReferralLink(){

    const input =
        document.getElementById("referralLink");

    if(!input || !input.value.trim()){

        showToast(
            "Referral link is not available.",
            "error"
        );

        return;
    }

    const value =
        input.value.trim();

    try{

        if(
            navigator.clipboard &&
            window.isSecureContext
        ){

            await navigator.clipboard.writeText(value);

        }else{

            const textarea =
                document.createElement("textarea");

            textarea.value = value;

            textarea.style.position = "fixed";
            textarea.style.left = "-9999px";
            textarea.style.top = "0";
            textarea.style.opacity = "0";

            document.body.appendChild(textarea);

            textarea.focus();
            textarea.select();
            textarea.setSelectionRange(
                0,
                value.length
            );

            const copied =
                document.execCommand("copy");

            document.body.removeChild(textarea);

            if(!copied){

                throw new Error("Copy failed");
            }
        }

        showToast(
            "Referral link copied successfully.",
            "success"
        );

    }catch(error){

        console.error(
            "REFERRAL COPY ERROR:",
            error
        );

        showToast(
            "Unable to copy referral link.",
            "error"
        );

    }

}
/* =========================================================
   PROFILE CHANGE PASSWORD UI
========================================================= */
function openForgotPassword(){

    passwordResetForgotMode = true;

    document.body.classList.add("forgot-password-active");

    const authPage = document.getElementById("authPage");
    const dashboardApp = document.getElementById("dashboardApp");
    const forgotPage = document.getElementById("forgotPasswordPage");
    const forgotInner = forgotPage ? forgotPage.querySelector(".forgot-password-inner") : null;
    const passwordPanel = document.getElementById("profileChangePasswordPanel");

    if(authPage){
        authPage.style.display = "none";
    }

    if(dashboardApp){
        dashboardApp.classList.remove("active");
        dashboardApp.style.display = "block";
    }

    if(forgotPage){
        forgotPage.style.display = "flex";
    }

    if(passwordPanel && forgotInner){

        if(!window.forgotPasswordOriginalParent){
            window.forgotPasswordOriginalParent = passwordPanel.parentNode;
        }

        forgotInner.appendChild(passwordPanel);
        passwordPanel.style.display = "block";
    }

    const profileCard = document.querySelector("#page-profile .profile-card");

    if(profileCard){
        profileCard.style.display = "";
    }

    const emailCard = document.querySelector("#profileChangePasswordPanel .profile-password-email-card");
    const emailInputWrap = document.getElementById("forgotPasswordEmailInputWrap");

    if(emailCard){
        emailCard.style.display = "none";
    }

    if(emailInputWrap){
        emailInputWrap.style.display = "block";
    }

    const emailInput = document.getElementById("forgotPasswordEmailInput");

    if(emailInput){
        emailInput.value = "";

        setTimeout(function(){
            emailInput.focus();
        },100);
    }

    const step1 = document.getElementById("profilePasswordOtpStep1");
    const step2 = document.getElementById("profilePasswordOtpStep2");
    const step3 = document.getElementById("profilePasswordOtpStep3");
    const success = document.getElementById("profilePasswordSuccess");

    if(step1){
        step1.style.display = "block";
    }

    if(step2){
        step2.style.display = "none";
    }

    if(step3){
        step3.style.display = "none";
    }

    if(success){
        success.style.display = "none";
    }
}
let passwordResetForgotMode = false;

function openChangePassword(){

    passwordResetForgotMode = false;

    const profileCard =
        document.querySelector("#page-profile .profile-card");

    const passwordPanel =
        document.getElementById("profileChangePasswordPanel");

    if(!profileCard || !passwordPanel){
        console.error("Change Password panel not found.");
        return;
    }

    profileCard.style.display = "none";
    passwordPanel.style.display = "block";

    const emailBox =
        document.getElementById("profilePasswordEmail");

    if(emailBox){
        emailBox.textContent =
            currentUser && currentUser.email
 currentUser.email
                : "Email unavailable";
    }

    passwordPanel.scrollIntoView({
        behavior: "smooth",
        block: "start"
    });
}


function closeForgotPassword(){
    closeChangePassword();
}

function closeChangePassword(){

    const passwordPanel =
        document.getElementById("profileChangePasswordPanel");

    if(!passwordPanel){
        return;
    }

    if(passwordResetForgotMode){

        passwordPanel.style.display = "none";

        if(window.forgotPasswordOriginalParent){
            window.forgotPasswordOriginalParent.appendChild(passwordPanel);
        }

        const forgotPage =
            document.getElementById("forgotPasswordPage");

        if(forgotPage){
            forgotPage.style.display = "none";
        }

        window.forgotPasswordOriginalParent = null;
        passwordResetForgotMode = false;

        const authPage =
            document.getElementById("authPage");

        const loginBox =
            document.getElementById("loginFormBox");

        if(authPage){
            authPage.style.display = "flex";
        }

        if(loginBox){
            loginBox.classList.remove("hidden");
        }

        document.body.classList.remove("forgot-password-active");
        return;
    }

    const profileCard =
        document.querySelector("#page-profile .profile-card");

    if(!profileCard){
        return;
    }

    passwordPanel.style.display = "none";
    profileCard.style.display = "";

    passwordPanel.scrollIntoView({
        behavior: "smooth",
        block: "start"
    });
}


function toggleProfilePassword(inputId, button){

    const input =
        document.getElementById(inputId);

    if(!input){
        return;
    }

    if(input.type === "password"){

        input.type = "text";

        button.textContent = "??";

    }else{

        input.type = "password";

        button.textContent = "??";

    }
}
/* =========================================================
   PROFILE PASSWORD - OTP + CHANGE PASSWORD
========================================================= */

async function sendProfilePasswordOTP(){

    try{

        let email = "";

        if(passwordResetForgotMode){

            const forgotEmailInput =
                document.getElementById(
                    "forgotPasswordEmailInput"
                );

            email =
                forgotEmailInput
     String(
                        forgotEmailInput.value || ""
                    ).trim().toLowerCase()
                    : "";

        }else{

            email =
                currentUser &&
                currentUser.email
     currentUser.email
                    : "";
        }

        if(!email){
            showToast(
                "Unable to find your registered email.",
                "error"
            );
            return;
        }

        const emailBox =
            document.getElementById(
                "profilePasswordEmail"
            );

        if(emailBox){
            emailBox.textContent = email;
        }

        const sendBtn =
            document.getElementById(
                "profilePasswordSendOtpBtn"
            );

        const resendBtn =
            document.getElementById(
                "profilePasswordResendBtn"
            );

        if(sendBtn){
            sendBtn.disabled = true;
            sendBtn.innerHTML =
                "<span></span> Sending OTP...";
        }

        if(resendBtn){
            resendBtn.disabled = true;
            resendBtn.textContent = "Sending...";
        }

        const data =
            await api(
                "/api/password-reset/send-otp",
                {
                    method:"POST",
                    headers:{
                        "Content-Type":
                            "application/json"
                    },
                    body:JSON.stringify({
                        email:email
                    })
                }
            );

        if(!data || !data.success){

            throw new Error(
                data &&
                data.message
     data.message
                    : "Unable to send OTP."
            );

        }

        const step1 =
            document.getElementById(
                "profilePasswordOtpStep1"
            );

        const step2 =
            document.getElementById(
                "profilePasswordOtpStep2"
            );

        if(step1){
            step1.style.display = "none";
        }

        if(step2){
            step2.style.display = "block";
        }

        const otpInput =
            document.getElementById(
                "profilePasswordOTP"
            );

        if(otpInput){
            otpInput.value = "";
            setTimeout(() => otpInput.focus(), 100);
        }

        showToast(
            data.message ||
            "OTP sent to your registered email.",
            "success"
        );

    }catch(error){

        console.error(
            "PROFILE PASSWORD SEND OTP ERROR:",
            error
        );

        showToast(
            error.message ||
            "Unable to send OTP.",
            "error"
        );

    }finally{

        const sendBtn =
            document.getElementById(
                "profilePasswordSendOtpBtn"
            );

        const resendBtn =
            document.getElementById(
                "profilePasswordResendBtn"
            );

        if(sendBtn){

            sendBtn.disabled = false;

            sendBtn.innerHTML =
                "<span></span> Get OTP";

        }

        if(resendBtn){

            resendBtn.disabled = false;
            resendBtn.textContent = "Resend OTP";

        }

    }

}


async function verifyProfilePasswordOTP(){

    try{

        let email = "";

        if(passwordResetForgotMode){

            const forgotEmailInput =
                document.getElementById(
                    "forgotPasswordEmailInput"
                );

            email =
                forgotEmailInput
     String(
                        forgotEmailInput.value || ""
                    ).trim().toLowerCase()
                    : "";

        }else{

            email =
                currentUser &&
                currentUser.email
     currentUser.email
                    : "";
        }

        const otpInput =
            document.getElementById(
                "profilePasswordOTP"
            );

        const otp =
            otpInput
 String(otpInput.value || "").trim()
                : "";

        if(!email){

            showToast(
                "Unable to find your registered email.",
                "error"
            );

            return;
        }

        if(!/^\d{6}$/.test(otp)){

            showToast(
                "Please enter the 6-digit OTP.",
                "error"
            );

            return;
        }

        const verifyBtn =
            document.getElementById(
                "profilePasswordVerifyBtn"
            );

        if(verifyBtn){

            verifyBtn.disabled = true;

            verifyBtn.innerHTML =
                "<span></span> Verifying...";

        }

        const data =
            await api(
                "/api/password-reset/verify-otp",
                {
                    method:"POST",
                    headers:{
                        "Content-Type":
                            "application/json"
                    },
                    body:JSON.stringify({
                        email:email,
                        otp:otp
                    })
                }
            );

        if(!data || !data.success){

            throw new Error(
                data &&
                data.message
     data.message
                    : "Unable to verify OTP."
            );

        }

        const step2 =
            document.getElementById(
                "profilePasswordOtpStep2"
            );

        const step3 =
            document.getElementById(
                "profilePasswordOtpStep3"
            );

        if(step2){
            step2.style.display = "none";
        }

        if(step3){
            step3.style.display = "block";
        }

        const newPassword =
            document.getElementById(
                "profileNewPassword"
            );

        if(newPassword){

            newPassword.value = "";

            setTimeout(
                () => newPassword.focus(),
                100
            );

        }

        const confirmPassword =
            document.getElementById(
                "profileConfirmPassword"
            );

        if(confirmPassword){
            confirmPassword.value = "";
        }

        updateProfilePasswordStrength();

        showToast(
            data.message ||
            "OTP verified successfully.",
            "success"
        );

    }catch(error){

        console.error(
            "PROFILE PASSWORD VERIFY OTP ERROR:",
            error
        );

        showToast(
            error.message ||
            "Unable to verify OTP.",
            "error"
        );

    }finally{

        const verifyBtn =
            document.getElementById(
                "profilePasswordVerifyBtn"
            );

        if(verifyBtn){

            verifyBtn.disabled = false;

            verifyBtn.innerHTML =
                "<span></span> Verify OTP";

        }

    }

}


function updateProfilePasswordStrength(){

    const input =
        document.getElementById(
            "profileNewPassword"
        );

    const bar =
        document.getElementById(
            "profilePasswordStrengthBar"
        );

    const text =
        document.getElementById(
            "profilePasswordStrengthText"
        );

    if(!input || !bar || !text){
        return;
    }

    const password =
        String(input.value || "");

    let score = 0;

    if(password.length >= 8){
        score++;
    }

    if(/[a-z]/.test(password)){
        score++;
    }

    if(/[A-Z]/.test(password)){
        score++;
    }

    if(/\d/.test(password)){
        score++;
    }

    if(/[^A-Za-z0-9]/.test(password)){
        score++;
    }

    const widths = [
        "0%",
        "20%",
        "40%",
        "60%",
        "80%",
        "100%"
    ];

    const labels = [
        "Password strength",
        "Very weak",
        "Weak",
        "Medium",
        "Strong",
        "Very strong"
    ];

    bar.style.width =
        widths[score];

    text.textContent =
        labels[score];

}


async function submitProfilePasswordChange(){

    try{

        const newPassword =
            String(
                (
                    document.getElementById(
                        "profileNewPassword"
                    ) || {}
                ).value || ""
            );

        const confirmPassword =
            String(
                (
                    document.getElementById(
                        "profileConfirmPassword"
                    ) || {}
                ).value || ""
            );

        if(!newPassword){

            showToast(
                "New password is required.",
                "error"
            );

            return;
        }

        if(!confirmPassword){

            showToast(
                "Please confirm your new password.",
                "error"
            );

            return;
        }

        if(newPassword !== confirmPassword){

            showToast(
                "New password and confirm password do not match.",
                "error"
            );

            return;
        }

        if(newPassword.length < 8){

            showToast(
                "Password must be at least 8 characters long.",
                "error"
            );

            return;
        }

        const changeBtn =
            document.getElementById(
                "profilePasswordChangeBtn"
            );

        if(changeBtn){

            changeBtn.disabled = true;

            changeBtn.innerHTML =
                "<span></span> Updating Password...";

        }

        const data =
            await api(
                "/api/password-reset/change",
                {
                    method:"POST",
                    headers:{
                        "Content-Type":
                            "application/json"
                    },
                    body:JSON.stringify({
                        newPassword:
                            newPassword,
                        confirmPassword:
                            confirmPassword
                    })
                }
            );

        if(!data || !data.success){

            throw new Error(
                data &&
                data.message
     data.message
                    : "Unable to change password."
            );

        }

        const step3 =
            document.getElementById(
                "profilePasswordOtpStep3"
            );

        const success =
            document.getElementById(
                "profilePasswordSuccess"
            );

        if(step3){
            step3.style.display = "none";
        }

        if(success){
            success.style.display = "block";
        }

        showToast(
            data.message ||
            "Password changed successfully.",
            "success"
        );

    }catch(error){

        console.error(
            "PROFILE PASSWORD CHANGE ERROR:",
            error
        );

        showToast(
            error.message ||
            "Unable to change password.",
            "error"
        );

    }finally{

        const changeBtn =
            document.getElementById(
                "profilePasswordChangeBtn"
            );

        if(changeBtn){

            changeBtn.disabled = false;

            changeBtn.innerHTML =
                "<span></span> Change Password";

        }

    }

}


document.addEventListener(
    "input",
    function(event){

        if(
            event.target &&
            event.target.id ===
                "profileNewPassword"
        ){

            updateProfilePasswordStrength();

        }

    }
);

