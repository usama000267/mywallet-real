/* ================= FORGOT PASSWORD FULLSCREEN ================= */
body.forgot-password-active{
    overflow:hidden;
}

body.forgot-password-active #forgotPasswordPage{
    position:fixed;
    inset:0;
    z-index:99999;
    width:100%;
    height:100vh;
    height:100dvh;
    min-height:100vh;
    min-height:100dvh;
    margin:0;
    padding:0;
    display:flex !important;
    align-items:stretch;
    justify-content:center;
    overflow-y:auto;
    overflow-x:hidden;
    box-sizing:border-box;
    background:linear-gradient(145deg,#f8faff,#eef2ff);
}

body.forgot-password-active #forgotPasswordPage .forgot-password-inner{
    width:100%;
    min-height:100vh;
    min-height:100dvh;
    margin:0;
    padding:clamp(24px,5vw,52px);
    box-sizing:border-box;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:flex-start;
}

body.forgot-password-active #forgotPasswordPage .forgot-password-back{
    width:100%;
    max-width:760px;
    margin:0 auto 22px;
    padding:12px 0;
    border:0;
    background:transparent;
    color:#5b21b6;
    font-size:15px;
    font-weight:700;
    text-align:left;
    cursor:pointer;
}

body.forgot-password-active #forgotPasswordPage #profileChangePasswordPanel{
    width:100%;
    max-width:760px;
    min-height:auto;
    margin:0 auto;
    padding:28px;
    box-sizing:border-box;
    border-radius:24px;
    background:rgba(255,255,255,.98);
    box-shadow:0 20px 60px rgba(30,41,59,.12);
}

body.forgot-password-active #forgotPasswordEmailInputWrap{
    margin-top:16px !important;
}

body.forgot-password-active #forgotPasswordEmailInput{
    width:100%;
    min-height:56px;
    box-sizing:border-box;
    padding:0 16px !important;
    border:1px solid #dbe3ef;
    border-radius:16px !important;
    background:#fff;
    font-size:15px !important;
    color:#172033;
    outline:none;
    transition:.2s ease;
}

body.forgot-password-active #forgotPasswordEmailInput:focus{
    border-color:#7c3aed;
    box-shadow:0 0 0 4px rgba(124,58,237,.10);
}

body.forgot-password-active #profilePasswordSendOtpBtn{
    width:100%;
    min-height:58px;
    margin-top:20px;
    border-radius:17px;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
}

@media(max-width:600px){
    body.forgot-password-active #forgotPasswordPage .forgot-password-inner{
        min-height:100dvh;
        padding:14px 14px 28px;
    }

    body.forgot-password-active #forgotPasswordPage .forgot-password-back{
        margin-bottom:12px;
        padding:10px 2px;
    }

    body.forgot-password-active #forgotPasswordPage #profileChangePasswordPanel{
        max-width:none;
        padding:20px 16px 24px;
        border-radius:20px;
    }

    body.forgot-password-active .profile-password-panel-head{
        margin-bottom:20px;
    }

    body.forgot-password-active .profile-password-panel-title{
        font-size:21px;
    }

    body.forgot-password-active .profile-password-step-badge{
        margin-bottom:16px;
    }

    body.forgot-password-active #profilePasswordSendOtpBtn{
        min-height:58px;
        margin-top:18px;
    }
}




