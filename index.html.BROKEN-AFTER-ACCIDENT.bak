}
/* =========================================================
   PREMIUM DEPOSIT PAGE
========================================================= */

#page-deposit{
    position:relative;
    padding-bottom:30px;
}

#page-deposit .section-head{
    margin-bottom:22px;
}

#page-deposit .section-title{
    font-size:28px;
    font-weight:900;
    letter-spacing:-.7px;
    background:linear-gradient(135deg,#5b4cf6,#06b6d4,#10b981);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
}

#page-deposit .section-subtitle{
    margin-top:6px;
    color:#64748b;
    font-size:13px;
    font-weight:600;
}

#page-deposit .form-card{
    position:relative;
    overflow:hidden;
    width:100%;
    max-width:900px;
    margin:0 auto;
    padding:30px;
    box-sizing:border-box;
    border:1px solid rgba(108,77,246,.12);
    border-radius:28px;
    background:
        radial-gradient(circle at 100% 0%,rgba(108,77,246,.12),transparent 32%),
        radial-gradient(circle at 0% 100%,rgba(6,182,212,.10),transparent 30%),
        rgba(255,255,255,.96);
    box-shadow:
        0 25px 70px rgba(15,23,42,.10),
        0 8px 25px rgba(108,77,246,.06);
    backdrop-filter:blur(20px);
    -webkit-backdrop-filter:blur(20px);
}

#page-deposit .form-card::before{
    content:"";
    position:absolute;
    top:0;
    left:0;
    right:0;
    height:5px;
    background:linear-gradient(
        90deg,#5b4cf6,#06b6d4,#10b981,#f59e0b
    );
}

#page-deposit .network-options{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:14px;
    margin-bottom:24px;
}

#page-deposit .network-option{
    position:relative;
    min-height:78px;
    padding:15px 18px;
    border:1px solid #e2e8f0;
    border-radius:18px;
    background:linear-gradient(145deg,#fff,#f8fafc);
    color:#334155;
    text-align:left;
    cursor:pointer;
    transition:all .25s ease;
    box-shadow:0 5px 18px rgba(15,23,42,.045);
}

#page-deposit .network-option:hover{
    transform:translateY(-3px);
    border-color:rgba(108,77,246,.28);
    box-shadow:0 12px 28px rgba(108,77,246,.10);
}

#page-deposit .network-option.selected{
    border-color:rgba(108,77,246,.45);
    background:linear-gradient(
        135deg,
        rgba(108,77,246,.11),
        rgba(6,182,212,.08)
    );
    box-shadow:0 10px 28px rgba(108,77,246,.13);
}

#page-deposit .network-option.selected::after{
    content:"✓";
    position:absolute;
    right:13px;
    top:13px;
    width:23px;
    height:23px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    color:#fff;
    font-size:12px;
    font-weight:900;
    background:linear-gradient(135deg,#5b4cf6,#06b6d4);
}

#page-deposit .network-option strong{
    display:block;
    margin-bottom:5px;
    color:#172033;
    font-size:15px;
    font-weight:900;
}

#page-deposit .network-option span{
    display:block;
    color:#64748b;
    font-size:11px;
    font-weight:650;
}

#page-deposit .form-group{
    margin-bottom:20px;
}

#page-deposit label{
    display:block;
    margin-bottom:8px;
    color:#334155;
    font-size:12px;
    font-weight:850;
}

#page-deposit .address-box{
    display:flex;
    gap:10px;
    padding:8px;
    border:1px solid rgba(108,77,246,.13);
    border-radius:17px;
    background:linear-gradient(135deg,#f8fafc,#fff);
    box-shadow:0 5px 18px rgba(15,23,42,.035);
}

#page-deposit #depositAddress{
    min-width:0;
    height:48px;
    border:0;
    background:transparent;
    box-shadow:none;
    color:#334155;
    font-size:12px;
    font-weight:700;
}

#page-deposit #depositAddress:focus{
    outline:none;
    box-shadow:none;
}

#page-deposit .copy-btn{
    flex:0 0 auto;
    min-width:82px;
    min-height:48px;
    border:0;
    border-radius:13px;
    color:#fff;
    font-weight:850;
    background:linear-gradient(135deg,#5b4cf6,#06b6d4);
    box-shadow:0 8px 18px rgba(91,76,246,.20);
    transition:all .22s ease;
}

#page-deposit .copy-btn:hover{
    transform:translateY(-2px);
}

#page-deposit .form-control{
    width:100%;
    min-height:52px;
    box-sizing:border-box;
    padding:13px 15px;
    border:1px solid #dbe3ef;
    border-radius:15px;
    background:rgba(255,255,255,.9);
    color:#172033;
    font-size:14px;
    font-weight:650;
    transition:all .22s ease;
}

#page-deposit .form-control::placeholder{
    color:#94a3b8;
}

#page-deposit .form-control:focus{
    outline:none;
    border-color:rgba(91,76,246,.55);
    box-shadow:
        0 0 0 4px rgba(91,76,246,.09),
        0 8px 22px rgba(91,76,246,.07);
}

#page-deposit #depositAmount{
    font-size:18px;
    font-weight:850;
}

#page-deposit #depositForm .btn-primary{
    width:100%;
    min-height:56px;
    margin-top:7px;
    border:0;
    border-radius:17px;
    color:#fff;
    font-size:14px;
    font-weight:900;
    background:linear-gradient(
        110deg,
        #5b4cf6,
        #7c3aed,
        #06b6d4,
        #10b981
    );
    box-shadow:
        0 13px 28px rgba(91,76,246,.23),
        0 4px 12px rgba(6,182,212,.10);
    transition:all .25s ease;
}

#page-deposit #depositForm .btn-primary:hover{
    transform:translateY(-3px);
    box-shadow:0 18px 35px rgba(91,76,246,.28);
}

@media(max-width:700px){

    #page-deposit{
        padding-bottom:95px;
    }

    #page-deposit .section-title{
        font-size:24px;
    }

    #page-deposit .form-card{
        padding:22px 15px;
        border-radius:22px;
    }

    #page-deposit .network-options{
        grid-template-columns:1fr;
        gap:10px;
    }

    #page-deposit .network-option{
        min-height:70px;
    }

    #page-deposit .address-box{
        gap:7px;
        padding:6px;
    }

    #page-deposit #depositAddress{
        font-size:10px;
    }

    #page-deposit .copy-btn{
        min-width:72px;
        min-height:45px;
    }

    #page-deposit .form-control{
        min-height:49px;
    }

    #page-deposit #depositForm .btn-primary{
        min-height:53px;
    }
}

@media(max-width:400px){

    #page-deposit .form-card{
        padding:19px 12px;
    }

    #page-deposit .address-box{
        flex-direction:column;
    }

    #page-deposit .copy-btn{
        width:100%;
    }
}
