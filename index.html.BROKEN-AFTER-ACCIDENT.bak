    border-radius:14px !important;
    background:linear-gradient(135deg,rgba(108,77,246,.12),rgba(6,182,212,.10)) !important;
    position:relative;
}
.stat-icon::before{
    content:"";
    width:22px;
    height:22px;
    display:block;
    background:linear-gradient(135deg,#6c4df6,#06b6d4);
    -webkit-mask-size:contain;
    mask-size:contain;
    -webkit-mask-repeat:no-repeat;
    mask-repeat:no-repeat;
    -webkit-mask-position:center;
    mask-position:center;
