<style>
/* MOBILE BOTTOM NAV FINAL FIX */
@media(max-width:1100px){
    .mobile-nav{
        position:fixed !important;
        left:7px !important;
        right:7px !important;
        bottom:max(10px, env(safe-area-inset-bottom)) !important;
