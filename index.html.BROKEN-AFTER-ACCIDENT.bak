async function checkExistingSession(){

    try{

        const data = await api("/api/me");


        if(
            data &&
            (
                data.success !== false ||
                data.user
            )
        ){

            currentUser =
                data.user ||
                data.data ||
                data;


            if(currentUser && currentUser.id){

                await startApplication();

                return;
            }

        }

    }catch(error){

        console.log("No active session.");

    }


    document.getElementById("authPage").style.display =
        "flex";

}


