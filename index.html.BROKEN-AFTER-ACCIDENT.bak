/* =========================================================
   REGISTRATION EMAIL OTP
========================================================= */

let registrationOtpTimer = null;
let registrationOtpSeconds = 0;


async function sendRegistrationOTP(){

    const emailInput =
        document.getElementById("registerEmail");

    const button =
        document.getElementById("registerSendOtpBtn");

    const message =
        document.getElementById("registerOtpMessage");


    const email =
        String(
            emailInput?.value || ""
        ).trim();


    if(!email){

        message.textContent =
            "Please enter your email address.";

        message.style.color =
            "#dc2626";

        emailInput?.focus();

        return;
    }


    /* Basic email check */

    const emailPattern =
        /^[^\s@]+@[^\s@]+\.[^\s@]+$/;


    if(!emailPattern.test(email)){

        message.textContent =
            "Please enter a valid email address.";

        message.style.color =
            "#dc2626";

        emailInput?.focus();

        return;
    }


    button.disabled = true;

    button.textContent =
        "Sending...";

    message.textContent =
        "";


    try{

        const response =
            await fetch(
                "/api/register/send-otp",
                {
                    method:"POST",

                    headers:{
                        "Content-Type":
                            "application/json"
                    },

                    body:JSON.stringify({
                        email:email
                    })
                }
            );


        const data =
            await response.json();


        if(!response.ok || !data.success){

            throw new Error(
                data.message ||
                "Unable to send OTP."
            );
        }


        message.textContent =
            "OTP sent successfully. Please check your email.";

        message.style.color =
            "#16a34a";


        startRegistrationOtpTimer();


    }catch(error){

        console.error(
            "Registration OTP:",
            error
        );


        message.textContent =
            error.message ||
            "Unable to send OTP.";

        message.style.color =
            "#dc2626";


        button.disabled = false;

        button.textContent =
            "Send OTP";
    }
}


/* =========================================================
   OTP COUNTDOWN
========================================================= */

function startRegistrationOtpTimer(){

    const button =
        document.getElementById(
            "registerSendOtpBtn"
        );


    registrationOtpSeconds =
        60;


    if(registrationOtpTimer){

        clearInterval(
            registrationOtpTimer
        );
    }


    button.disabled = true;


    button.textContent =
        `Resend (${registrationOtpSeconds}s)`;


    registrationOtpTimer =
        setInterval(
            function(){

                registrationOtpSeconds--;


                if(
                    registrationOtpSeconds <= 0
                ){

                    clearInterval(
                        registrationOtpTimer
                    );

                    registrationOtpTimer =
                        null;


                    button.disabled =
                        false;

                    button.textContent =
                        "Resend OTP";

                    return;
                }


                button.textContent =
                    `Resend (${registrationOtpSeconds}s)`;

            },
            1000
        );
