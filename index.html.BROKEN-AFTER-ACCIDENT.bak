/* =========================================================
   PREMIUM NFT SALES HISTORY
========================================================= */

.sell-history-premium{
    position:relative;
    margin-top:24px;
    padding:22px;
    border-radius:24px;
    background:
        linear-gradient(145deg,#ffffff,#f7f8ff);
    border:1px solid rgba(91,76,246,.12);
    box-shadow:
        0 18px 45px rgba(15,23,42,.08),
        0 5px 18px rgba(91,76,246,.08);
    overflow:hidden;
}

.sell-history-premium::before{
    content:"";
    position:absolute;
    width:180px;
    height:180px;
    right:-80px;
    top:-90px;
    border-radius:50%;
    background:rgba(124,58,237,.10);
    filter:blur(8px);
    pointer-events:none;
}

.sell-history-premium::after{
    content:"";
    position:absolute;
    width:150px;
    height:150px;
    left:-80px;
    bottom:-90px;
    border-radius:50%;
    background:rgba(6,182,212,.09);
    filter:blur(8px);
    pointer-events:none;
}

.sell-history-head{
    position:relative;
    z-index:2;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:14px;
    margin-bottom:18px;
}

.sell-history-title{
    font-size:19px;
    font-weight:900;
    color:#172033;
    letter-spacing:-.35px;
}

.sell-history-subtitle{
    margin-top:5px;
    font-size:11px;
    color:#64748b;
}

.sell-history-badge{
    flex:0 0 auto;
    padding:7px 11px;
    border-radius:999px;
    font-size:9px;
    font-weight:900;
    letter-spacing:.8px;
    color:#ffffff;
    background:linear-gradient(
        135deg,
        #5b4cf6,
        #7c3aed,
        #06b6d4
    );
    box-shadow:
        0 7px 18px rgba(91,76,246,.22);
}

.sell-history-records{
    position:relative;
    z-index:2;
    display:flex;
    flex-direction:column;
    gap:11px;
}

.sell-history-record{
    display:grid;
    grid-template-columns:minmax(0,1fr) auto;
    gap:14px;
    align-items:center;
    padding:15px;
    border-radius:17px;
    background:rgba(255,255,255,.92);
    border:1px solid rgba(148,163,184,.16);
    box-shadow:0 7px 20px rgba(15,23,42,.055);
    transition:all .22s ease;
}

.sell-history-record:hover{
    transform:translateY(-2px);
    border-color:rgba(91,76,246,.22);
    box-shadow:
        0 12px 28px rgba(91,76,246,.10);
}

.sell-history-main{
    min-width:0;
}

.sell-history-nft{
    font-size:13px;
    font-weight:850;
    color:#172033;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.sell-history-date{
    margin-top:5px;
    font-size:10px;
    color:#94a3b8;
}

.sell-history-values{
    display:flex;
    align-items:center;
    gap:8px;
    flex-wrap:wrap;
    margin-top:10px;
}

.sell-value{
    padding:6px 9px;
    border-radius:9px;
    font-size:10px;
    font-weight:800;
    background:#f8fafc;
    color:#475569;
}

.sell-value.sale{
    color:#5b21b6;
    background:#f3e8ff;
}

.sell-value.profit{
    color:#047857;
    background:#dcfce7;
}

.sell-history-profit{
    min-width:72px;
    padding:10px 9px;
    border-radius:12px;
    text-align:center;
    background:linear-gradient(
        135deg,
        #ecfdf5,
        #d1fae5
    );
    border:1px solid rgba(16,185,129,.16);
}

.sell-history-profit-label{
    display:block;
    font-size:8px;
    font-weight:800;
    color:#059669;
    text-transform:uppercase;
    letter-spacing:.5px;
}

.sell-history-profit-amount{
    display:block;
    margin-top:2px;
    font-size:13px;
    font-weight:950;
    color:#047857;
}

.sell-history-empty{
    padding:28px 15px;
    text-align:center;
    border-radius:16px;
    color:#94a3b8;
    font-size:11px;
    background:#f8fafc;
    border:1px dashed rgba(148,163,184,.28);
}

@media(max-width:600px){

    .sell-history-premium{
        margin-top:18px;
        padding:16px 12px;
        border-radius:20px;
    }

    .sell-history-head{
        margin-bottom:14px;
    }

    .sell-history-title{
        font-size:17px;
    }

    .sell-history-record{
        grid-template-columns:1fr;
        gap:10px;
        padding:13px;
    }

    .sell-history-profit{
        width:100%;
        box-sizing:border-box;
    }

    .sell-history-values{
        gap:6px;
    }

    .sell-value{
        font-size:9px;
        padding:6px 8px;
    }
}
.nav-icon svg{
    width:20px;
    height:20px;
    display:block;
    fill:none;
    stroke:currentColor;
    stroke-width:1.9;
    stroke-linecap:round;
    stroke-linejoin:round;
    flex-shrink:0;
}
.nav-item:hover .nav-icon svg{
    stroke-width:2.2;
}
