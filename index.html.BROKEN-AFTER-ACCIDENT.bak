        visibility:visible !important;
        opacity:1 !important;
        fill:none !important;
        stroke:#2563eb !important;
        stroke-width:2 !important;
        stroke-linecap:round !important;
        stroke-linejoin:round !important;
    }

    .mobile-menu-items button .mobile-nav-icon svg path,
    .mobile-menu-items button .mobile-nav-icon svg circle,
    .mobile-menu-items button .mobile-nav-icon svg rect,
    .mobile-menu-footer button .mobile-nav-icon svg path,
    .mobile-menu-footer button .mobile-nav-icon svg circle,
    .mobile-menu-footer button .mobile-nav-icon svg rect{
