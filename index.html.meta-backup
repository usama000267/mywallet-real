<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Meta NFT</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

:root{
    --primary:#6c4df6;
    --primary2:#8b5cf6;
    --cyan:#06b6d4;
    --dark:#17142b;
    --muted:#73758a;
    --bg:#f7f7fb;
    --white:#ffffff;
    --border:#e9e8f2;
    --green:#16a34a;
    --red:#dc2626;
    --yellow:#d97706;
    --shadow:0 12px 35px rgba(34,27,72,.08);
}

body{
    font-family:Inter,Arial,Helvetica,sans-serif;
    background:var(--bg);
    color:var(--dark);
    min-height:100vh;
}

button,
input,
select{
    font:inherit;
}

button{
    cursor:pointer;
}

.hidden{
    display:none!important;
}

.app{
    min-height:100vh;
}

/* ================= AUTH ================= */

.auth-page{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:25px;
    background:
        radial-gradient(circle at 10% 10%,rgba(108,77,246,.15),transparent 30%),
        radial-gradient(circle at 90% 90%,rgba(6,182,212,.12),transparent 30%),
        #f8f8fc;
}

.auth-box{
    width:100%;
    max-width:450px;
    background:#fff;
    border:1px solid var(--border);
    border-radius:26px;
    box-shadow:var(--shadow);
    padding:35px;
}

.logo{
    display:flex;
    align-items:center;
    gap:11px;
    font-size:23px;
    font-weight:800;
    color:var(--dark);
}

.logo-icon{
    width:42px;
    height:42px;
    border-radius:13px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#fff;
    font-weight:900;
    background:linear-gradient(135deg,var(--primary),var(--cyan));
    box-shadow:0 8px 20px rgba(108,77,246,.25);
}

.auth-logo{
    justify-content:center;
    margin-bottom:25px;
}

.auth-title{
    text-align:center;
    font-size:28px;
    margin-bottom:8px;
}

.auth-subtitle{
    text-align:center;
    color:var(--muted);
    font-size:14px;
    margin-bottom:25px;
}

.form-group{
    margin-bottom:15px;
}

.form-group label{
    display:block;
    margin-bottom:7px;
    font-size:13px;
    font-weight:700;
}

.form-control{
    width:100%;
    border:1px solid var(--border);
    background:#fafafe;
    border-radius:12px;
    padding:13px 14px;
    outline:none;
    transition:.2s;
}

.form-control:focus{
    border-color:var(--primary);
    background:#fff;
    box-shadow:0 0 0 4px rgba(108,77,246,.08);
}

.btn{
    border:0;
    border-radius:12px;
    padding:12px 17px;
    font-weight:700;
    transition:.2s;
}

.btn:hover{
    transform:translateY(-1px);
}

.btn-primary{
    color:#fff;
    background:linear-gradient(135deg,var(--primary),var(--primary2));
    box-shadow:0 8px 18px rgba(108,77,246,.2);
}

.btn-secondary{
    color:var(--dark);
    background:#f1efff;
}

.btn-danger{
    color:#fff;
    background:var(--red);
}

.btn-success{
    color:#fff;
    background:var(--green);
}

.btn-full{
    width:100%;
}

.auth-switch{
    margin-top:20px;
    text-align:center;
    color:var(--muted);
    font-size:14px;
}

.auth-switch button{
    border:0;
    background:none;
    color:var(--primary);
    font-weight:800;
}

.auth-message{
    padding:11px 13px;
    border-radius:10px;
    font-size:13px;
    margin-bottom:15px;
    display:none;
}

.auth-message.error{
    display:block;
    background:#fff0f0;
    color:var(--red);
}

.auth-message.success{
    display:block;
    background:#effdf3;
    color:var(--green);
}

/* ================= LAYOUT ================= */

.dashboard-app{
    display:none;
    min-height:100vh;
}

.dashboard-app.active{
    display:flex;
}

.sidebar{
    width:250px;
    background:#fff;
    border-right:1px solid var(--border);
    position:fixed;
    top:0;
    left:0;
    bottom:0;
    z-index:100;
    padding:22px 15px;
}

.sidebar-logo{
    padding:5px 10px 25px;
}

.nav{
    display:flex;
    flex-direction:column;
    gap:5px;
}

.nav-item{
    width:100%;
    border:0;
    background:transparent;
    color:#686a7c;
    display:flex;
    align-items:center;
    gap:12px;
    padding:12px 14px;
    border-radius:12px;
    text-align:left;
    font-weight:650;
}

.nav-item:hover{
    background:#f5f3ff;
    color:var(--primary);
}

.nav-item.active{
    background:#eeeaff;
    color:var(--primary);
}

.nav-icon{
    width:21px;
    text-align:center;
    font-size:17px;
}

.sidebar-bottom{
    position:absolute;
    left:15px;
    right:15px;
    bottom:20px;
}

.logout-btn{
    color:#dc2626;
}

.main{
    margin-left:250px;
    width:calc(100% - 250px);
    min-height:100vh;
}

.topbar{
    height:75px;
    background:#fff;
    border-bottom:1px solid var(--border);
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 30px;
    position:sticky;
    top:0;
    z-index:50;
}

.topbar-title{
    font-size:21px;
    font-weight:800;
}

.user-mini{
    display:flex;
    align-items:center;
    gap:10px;
}

.avatar{
    width:38px;
    height:38px;
    border-radius:50%;
    background:linear-gradient(135deg,var(--primary),var(--cyan));
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:800;
}

.content{
    padding:28px;
    max-width:1450px;
    margin:auto;
}

.page{
    display:none;
}

.page.active{
    display:block;
}

/* ================= DASHBOARD ================= */

.welcome-card{
    border-radius:22px;
    padding:28px;
    color:#fff;
    background:
        radial-gradient(circle at 90% 20%,rgba(255,255,255,.2),transparent 25%),
        linear-gradient(135deg,#5d43e8,#7c52ed 55%,#0ea5c8);
    box-shadow:0 15px 35px rgba(108,77,246,.18);
    margin-bottom:22px;
}

.welcome-card h1{
    font-size:28px;
    margin-bottom:8px;
}

.welcome-card p{
    opacity:.9;
    font-size:14px;
}

.balance-card{
    margin-top:22px;
    background:rgba(255,255,255,.14);
    border:1px solid rgba(255,255,255,.18);
    padding:16px 18px;
    border-radius:15px;
    width:max-content;
    min-width:240px;
}

.balance-label{
    font-size:12px;
    opacity:.8;
}

.balance-value{
    font-size:27px;
    font-weight:850;
    margin-top:4px;
}

.stats-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:17px;
    margin-bottom:25px;
}

.stat-card{
    background:#fff;
    border:1px solid var(--border);
    border-radius:18px;
    padding:20px;
    box-shadow:0 5px 18px rgba(20,15,60,.03);
}

.stat-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:17px;
}

.stat-icon{
    width:43px;
    height:43px;
    border-radius:13px;
    background:#f0edff;
    color:var(--primary);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:19px;
}

.stat-title{
    color:var(--muted);
    font-size:13px;
}

.stat-value{
    font-size:25px;
    font-weight:850;
}

/* ================= SECTION ================= */

.section-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:17px;
}

.section-title{
    font-size:21px;
    font-weight:800;
}

.section-subtitle{
    color:var(--muted);
    font-size:13px;
    margin-top:4px;
}

.card{
    background:#fff;
    border:1px solid var(--border);
    border-radius:18px;
    box-shadow:0 5px 20px rgba(20,15,60,.03);
}

/* ================= NFT ================= */

.nft-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.nft-card{
    background:#fff;
    border:1px solid var(--border);
    border-radius:19px;
    overflow:hidden;
    box-shadow:0 7px 25px rgba(20,15,60,.05);
    transition:.2s;
}

.nft-card:hover{
    transform:translateY(-3px);
    box-shadow:0 15px 35px rgba(20,15,60,.1);
}

.nft-image{
    height:205px;
    background:linear-gradient(135deg,#ece8ff,#dff9ff);
    overflow:hidden;
    display:flex;
    align-items:center;
    justify-content:center;
}

.nft-image img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.nft-placeholder{
    font-size:55px;
}

.nft-body{
    padding:17px;
}

.nft-name{
    font-size:17px;
    font-weight:800;
    margin-bottom:6px;
}

.nft-description{
    color:var(--muted);
    font-size:12px;
    line-height:1.5;
    min-height:38px;
    margin-bottom:13px;
}

.nft-meta{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:15px;
}

.nft-price{
    font-size:20px;
    font-weight:850;
}

.nft-profit{
    font-size:12px;
    padding:5px 8px;
    border-radius:8px;
    color:var(--green);
    background:#ecfdf3;
}

.nft-card .btn{
    width:100%;
}

/* ================= MY NFT ================= */

.my-nft-list{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:18px;
}

.my-nft-card{
    padding:18px;
}

.my-nft-row{
    display:flex;
    gap:15px;
}

.my-nft-thumb{
    width:100px;
    height:100px;
    border-radius:14px;
    overflow:hidden;
    background:#eeeaff;
    flex-shrink:0;
}

.my-nft-thumb img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.my-nft-info{
    flex:1;
}

.badge{
    display:inline-flex;
    padding:5px 9px;
    border-radius:8px;
    font-size:11px;
    font-weight:800;
}

.badge-green{
    color:#15803d;
    background:#dcfce7;
}

.badge-yellow{
    color:#a16207;
    background:#fef9c3;
}

.badge-red{
    color:#b91c1c;
    background:#fee2e2;
}

.data-row{
    display:flex;
    justify-content:space-between;
    gap:15px;
    margin:9px 0;
    font-size:13px;
}

.data-row span:first-child{
    color:var(--muted);
}

.data-row strong{
    text-align:right;
}

.empty{
    padding:50px 20px;
    text-align:center;
    color:var(--muted);
}

.empty-icon{
    font-size:45px;
    margin-bottom:10px;
}

/* ================= FORMS ================= */

.form-card{
    padding:24px;
    max-width:700px;
}

.network-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:12px;
    margin-bottom:17px;
}

.network-option{
    border:1px solid var(--border);
    background:#fafafe;
    padding:15px;
    border-radius:13px;
    text-align:left;
}

.network-option.selected{
    border-color:var(--primary);
    background:#f1eeff;
}

.network-option strong{
    display:block;
    font-size:14px;
}

.network-option span{
    display:block;
    color:var(--muted);
    font-size:11px;
    margin-top:4px;
}

.address-box{
    display:flex;
    gap:8px;
    margin-bottom:18px;
}

.address-box input{
    flex:1;
}

.copy-btn{
    white-space:nowrap;
}

/* ================= HISTORY ================= */

.table-wrap{
    overflow:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:700px;
}

th,
td{
    padding:14px 15px;
    text-align:left;
    border-bottom:1px solid var(--border);
    font-size:13px;
}

th{
    background:#fafafe;
    color:var(--muted);
    font-size:12px;
}

/* ================= REFERRAL ================= */

.referral-card{
    padding:25px;
}

.referral-code{
    background:#f5f3ff;
    border:1px dashed var(--primary);
    padding:16px;
    border-radius:14px;
    font-size:20px;
    font-weight:850;
    text-align:center;
    color:var(--primary);
    margin:15px 0;
}

.referral-link{
    display:flex;
    gap:8px;
}

.referral-link input{
    flex:1;
}

/* ================= PROFILE ================= */

.profile-card{
    max-width:700px;
    padding:25px;
}

.profile-avatar{
    width:75px;
    height:75px;
    border-radius:22px;
    background:linear-gradient(135deg,var(--primary),var(--cyan));
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:28px;
    font-weight:850;
    margin-bottom:18px;
}

/* ================= MODAL ================= */

.modal{
    position:fixed;
    inset:0;
    background:rgba(10,8,25,.5);
    z-index:500;
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
}

.modal.show{
    display:flex;
}

.modal-box{
    background:#fff;
    border-radius:20px;
    width:100%;
    max-width:470px;
    padding:25px;
    box-shadow:0 20px 60px rgba(0,0,0,.18);
}

.modal-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:18px;
}

.modal-head h3{
    font-size:20px;
}

.close-btn{
    border:0;
    background:#f1f1f5;
    width:34px;
    height:34px;
    border-radius:50%;
}

/* ================= TOAST ================= */

.toast{
    position:fixed;
    right:20px;
    bottom:20px;
    z-index:1000;
    min-width:260px;
    max-width:380px;
    padding:14px 17px;
    border-radius:13px;
    background:#17142b;
    color:#fff;
    box-shadow:0 15px 40px rgba(0,0,0,.2);
    display:none;
    font-size:13px;
}

.toast.show{
    display:block;
}

.toast.success{
    background:#15803d;
}

.toast.error{
    background:#b91c1c;
}

/* ================= MOBILE ================= */

.mobile-header{
    display:none;
}

.mobile-nav{
    display:none;
}

@media(max-width:1100px){
    .stats-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .nft-grid{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:800px){
    .sidebar{
        display:none;
    }

    .main{
        margin-left:0;
        width:100%;
        padding-bottom:75px;
    }

    .topbar{
        padding:0 17px;
    }

    .content{
        padding:18px;
    }

    .mobile-header{
        display:block;
    }

    .nft-grid,
    .my-nft-list{
        grid-template-columns:1fr;
    }

    .mobile-nav{
        position:fixed;
        display:flex;
        bottom:0;
        left:0;
        right:0;
        height:65px;
        background:#fff;
        border-top:1px solid var(--border);
        z-index:200;
        justify-content:space-around;
        align-items:center;
    }

    .mobile-nav button{
        border:0;
        background:none;
        color:#777;
        font-size:10px;
        display:flex;
        flex-direction:column;
        align-items:center;
        gap:3px;
    }

    .mobile-nav button.active{
        color:var(--primary);
        font-weight:800;
    }

    .mobile-nav span{
        font-size:18px;
    }

    .welcome-card h1{
        font-size:23px;
    }

    .balance-card{
        width:100%;
    }
}

@media(max-width:550px){
    .stats-grid{
        grid-template-columns:1fr 1fr;
        gap:10px;
    }

    .stat-card{
        padding:14px;
    }

    .stat-value{
        font-size:19px;
    }

    .stat-icon{
        width:36px;
        height:36px;
    }

    .network-grid{
        grid-template-columns:1fr;
    }

    .auth-box{
        padding:25px 20px;
    }

    .my-nft-row{
        flex-direction:column;
    }

    .my-nft-thumb{
        width:100%;
        height:170px;
    }
}
</style>
</head>

<body>

<!-- ================= AUTH ================= -->

<div id="authPage" class="auth-page">

    <div class="auth-box">

        <div class="logo auth-logo">
            <div class="logo-icon">M</div>
            <span>Meta NFT</span>
        </div>

        <div id="loginFormBox">

            <h1 class="auth-title">Welcome Back</h1>
            <p class="auth-subtitle">Sign in to your Meta NFT account</p>

            <div id="loginMessage" class="auth-message"></div>

            <form id="loginForm">

                <div class="form-group">
                    <label>Email</label>
                    <input
                        id="loginEmail"
                        class="form-control"
                        type="email"
                        placeholder="Enter your email"
                        required
                    >
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input
                        id="loginPassword"
                        class="form-control"
                        type="password"
                        placeholder="Enter your password"
                        required
                    >
                </div>

                <button class="btn btn-primary btn-full" type="submit">
                    Login
                </button>

            </form>

            <div class="auth-switch">
                Don't have an account?
                <button type="button" onclick="showRegister()">
                    Create Account
                </button>
            </div>

        </div>

        <div id="registerFormBox" class="hidden">

            <h1 class="auth-title">Create Account</h1>
            <p class="auth-subtitle">Join Meta NFT today</p>

            <div id="registerMessage" class="auth-message"></div>

            <form id="registerForm">

                <div class="form-group">
                    <label>Full Name</label>
                    <input
                        id="registerName"
                        class="form-control"
                        type="text"
                        placeholder="Your full name"
                        required
                    >
                </div>

                <div class="form-group">
                    <label>Username</label>
                    <input
                        id="registerUsername"
                        class="form-control"
                        type="text"
                        placeholder="Choose username"
                    >
                </div>

              <div class="form-group">
    <label>Email</label>

    <div style="
        display:flex;
        gap:10px;
        align-items:stretch;
    ">

        <input
            id="registerEmail"
            class="form-control"
            type="email"
            placeholder="Enter email"
            required
            style="flex:1;"
        >

        <button
            type="button"
            id="registerSendOtpBtn"
            class="btn btn-primary"
            onclick="sendRegistrationOTP()"
            style="
                white-space:nowrap;
                min-width:110px;
            "
        >
            Send OTP
        </button>

    </div>
</div>

<div class="form-group">
    <label>Email Verification Code</label>

    <input
        id="registerOTP"
        class="form-control"
        type="text"
        inputmode="numeric"
        maxlength="6"
        placeholder="Enter 6-digit OTP"
        autocomplete="one-time-code"
    >

    <div
        id="registerOtpMessage"
        style="
            margin-top:7px;
            font-size:13px;
            color:#777;
        "
    ></div>
</div>

                <div class="form-group">
                    <label>Mobile</label>
                    <input
                        id="registerMobile"
                        class="form-control"
                        type="text"
                        placeholder="Mobile number"
                    >
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input
                        id="registerPassword"
                        class="form-control"
                        type="password"
                        placeholder="Create password"
                        required
                    >
                </div>

                <div class="form-group">
                    <label>Confirm Password</label>
                    <input
                        id="registerConfirmPassword"
                        class="form-control"
                        type="password"
                        placeholder="Confirm password"
                        required
                    >
                </div>

                <div class="form-group">
                    <label>Referral Code <span style="color:#999">(optional)</span></label>
                    <input
                        id="registerReferral"
                        class="form-control"
                        type="text"
                        placeholder="Referral code"
                    >
                </div>

                <button class="btn btn-primary btn-full" type="submit">
                    Create Account
                </button>

            </form>

            <div class="auth-switch">
                Already have an account?
                <button type="button" onclick="showLogin()">
                    Login
                </button>
            </div>

        </div>

    </div>

</div>


<!-- ================= DASHBOARD APP ================= -->

<div id="dashboardApp" class="dashboard-app">

    <!-- Sidebar -->
    <aside class="sidebar">

        <div class="sidebar-logo">
            <div class="logo">
                <div class="logo-icon">M</div>
                <span>Meta NFT</span>
            </div>
        </div>

        <nav class="nav">

            <button class="nav-item active" data-page="dashboard">
                <span class="nav-icon">⌂</span>
                Dashboard
            </button>

            <button class="nav-item" data-page="marketplace">
                <span class="nav-icon">◈</span>
                Marketplace
            </button>

            <button class="nav-item" data-page="my-nfts">
                <span class="nav-icon">◆</span>
                My NFTs
            </button>

