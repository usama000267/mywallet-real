<div id="toast" class="toast"></div>


<script>

/* =========================================================
   GLOBAL STATE
========================================================= */
let currentUser = null;
let appConfig = null;

let selectedDepositNetwork = "BEP20";
let selectedWithdrawNetwork = "BEP20";
let selectedBuyNFT = null;
let selectedSellNFT = null;


/* =========================================================
   HELPERS
========================================================= */

function escapeHtml(value){

    if(value === null || value === undefined){
        return "";
    }

    return String(value)
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");
}


function money(value){

    const n = Number(value || 0);

    return "$" + n.toLocaleString("en-US",{
        minimumFractionDigits:2,
        maximumFractionDigits:2
    });
}


function formatDate(value){

    if(!value){
        return "-";
    }

    const date = new Date(value);

    if(Number.isNaN(date.getTime())){
        return "-";
    }

    return date.toLocaleString();
}


function getInitial(name){

    if(!name){
        return "U";
    }

    return String(name).trim().charAt(0).toUpperCase();
}


function showToast(message,type=""){

    const toast = document.getElementById("toast");

    toast.textContent = message;

    toast.className = "toast show " + type;

    clearTimeout(window.toastTimer);

    window.toastTimer = setTimeout(()=>{
        toast.className = "toast";
    },3500);
}


async function api(url,options={}){

    try{

        const finalOptions = {
            ...options,
            headers:{
                ...(options.body ? {"Content-Type":"application/json"} : {}),
                ...(options.headers || {})
            }
        };

        const response = await fetch(url,finalOptions);

        const text = await response.text();

        let data = {};

        try{
            data = text ? JSON.parse(text) : {};
        }catch{
            throw new Error("Server returned an invalid response.");
        }

        if(!response.ok){

            throw new Error(
                data.message ||
                data.error ||
                "Request failed."
            );
        }

        return data;

    }catch(error){

        console.error("API ERROR:",url,error);

        throw error;
    }
}


/* =========================================================
   AUTH UI
========================================================= */

function showRegister(){

    document.getElementById("loginFormBox").classList.add("hidden");
    document.getElementById("registerFormBox").classList.remove("hidden");

    clearMessage("loginMessage");
}


function showLogin(){

    document.getElementById("registerFormBox").classList.add("hidden");
    document.getElementById("loginFormBox").classList.remove("hidden");

    clearMessage("registerMessage");
}


function showMessage(id,message,type="error"){

    const el = document.getElementById(id);

    if(!el){
        return;
    }

    el.textContent = message;

    el.className = "auth-message " + type;
}


function clearMessage(id){

    const el = document.getElementById(id);

    if(!el){
        return;
    }

    el.textContent = "";
    el.className = "auth-message";
}

/* =========================================================
   REGISTER
========================================================= */

document.getElementById("registerForm").addEventListener("submit",async function(e){

    e.preventDefault();

    clearMessage("registerMessage");


    const name =
        document.getElementById("registerName").value.trim();

    const username =
        document.getElementById("registerUsername").value.trim();

    const email =
        document.getElementById("registerEmail").value.trim();

    const mobile =
        document.getElementById("registerMobile").value.trim();

    const password =
        document.getElementById("registerPassword").value;

    const confirmPassword =
        document.getElementById("registerConfirmPassword").value;

    const referral =
        document.getElementById("registerReferral").value.trim();

    const otp =
        document.getElementById("registerOTP").value.trim();


    /* ==========================================
       PASSWORD CHECK
    ========================================== */

    if(password !== confirmPassword){

        showMessage(
            "registerMessage",
            "Passwords do not match.",
            "error"
        );

        return;
    }


    if(password.length < 6){

        showMessage(
            "registerMessage",
            "Password must contain at least 6 characters.",
            "error"
        );

        return;
    }


    /* ==========================================
       OTP CHECK
    ========================================== */

    if(!otp){

        showMessage(
            "registerMessage",
            "Please enter the 6-digit email verification code.",
            "error"
        );

        document
            .getElementById("registerOTP")
            .focus();

        return;
    }


    if(!/^\d{6}$/.test(otp)){

        showMessage(
            "registerMessage",
            "OTP must be exactly 6 digits.",
            "error"
        );

        document
            .getElementById("registerOTP")
            .focus();

        return;
    }


    const button =
        this.querySelector("button[type=submit]");

    const oldText =
        button.textContent;


    button.disabled = true;

    button.textContent =
        "Creating Account...";


    try{

        const data =
            await api(
                "/api/register",
                {
                    method:"POST",

                    body:JSON.stringify({

                        name,

                        fullName:name,

                        username,

                        email,

                        mobile,

                        password,

                        referralCode:referral,

                        referral_code:referral,

                        otp

                    })
                }
            );


        if(data.success === false){

            throw new Error(
                data.message ||
                "Registration failed."
            );
        }


        showMessage(
            "registerMessage",
            data.message ||
            "Account created successfully. Please login.",
            "success"
        );


        setTimeout(()=>{

            showLogin();

            document
                .getElementById("loginEmail")
                .value = email;

        },900);


    }catch(error){

        showMessage(
            "registerMessage",
            error.message,
            "error"
        );

    }finally{

        button.disabled = false;

        button.textContent =
            oldText;

    }

});

/* =========================================================
   LOGIN
========================================================= */

document.getElementById("loginForm").addEventListener("submit",async function(e){

    e.preventDefault();

    clearMessage("loginMessage");

    const email =
        document.getElementById("loginEmail").value.trim();

    const password =
        document.getElementById("loginPassword").value;


    const button =
        this.querySelector("button[type=submit]");

    const oldText = button.textContent;

    button.disabled = true;
    button.textContent = "Signing in...";


    try{

        const data = await api("/api/login",{

            method:"POST",

            body:JSON.stringify({
                email,
                password
            })

        });


        if(data.success === false){

            throw new Error(
                data.message || "Login failed."
            );
        }


        await startApplication();

    }catch(error){

        showMessage(
            "loginMessage",
            error.message,
            "error"
        );

    }finally{

        button.disabled = false;
        button.textContent = oldText;

    }

});


/* =========================================================
   START APP
========================================================= */

async function startApplication(){

    try{

        const meData = await api("/api/me");

        currentUser =
            meData.user ||
            meData.data ||
            meData;


        document.getElementById("authPage").style.display = "none";

        document.getElementById("dashboardApp").classList.add("active");


        updateUserUI();


        await loadConfig();

        await loadDashboard();

        await loadNFTs();

        await loadMyNFTs();

        await loadHistory();

        await loadReferral();

        showToast("Welcome to Meta NFT","success");


    }catch(error){

        console.error(error);

        document.getElementById("authPage").style.display = "flex";

        document.getElementById("dashboardApp").classList.remove("active");

        showToast(error.message,"error");

    }

}


/* =========================================================
   USER UI
========================================================= */

function updateUserUI(){

    if(!currentUser){
        return;
    }


    const name =
        currentUser.name ||
        currentUser.full_name ||
        currentUser.username ||
        "User";


    document.getElementById("welcomeName").textContent = name;

    document.getElementById("topUserName").textContent = name;

    document.getElementById("topAvatar").textContent =
        getInitial(name);

    document.getElementById("profileAvatar").textContent =
        getInitial(name);

    document.getElementById("profileName").textContent =
        name;

    document.getElementById("profileEmail").textContent =
        currentUser.email || "-";

    document.getElementById("profileReferral").textContent =
        currentUser.referral_code ||
        currentUser.referralCode ||
        "-";

    document.getElementById("profileBalance").textContent =
        money(currentUser.balance);

}


/* =========================================================
   CONFIG
========================================================= */

async function loadConfig(){

    try{

        const data = await api("/api/config");

        appConfig =
            data.config ||
            data;

        updateDepositAddress();

    }catch(error){

        console.error("CONFIG ERROR:",error);

        document.getElementById("depositAddress").value =
            "Address unavailable";

    }

}


function getNetworkAddress(network){

    if(!appConfig){
        return "";
    }


    if(network === "BEP20"){

        return (
            appConfig.networks?.bep20?.address ||
            appConfig.usdtBep20Address ||
            appConfig.usdt_bep20_address ||
            appConfig.bep20Address ||
            appConfig.bep20_address ||
            appConfig.USDT_BEP20 ||
            ""
        );

    }


    if(network === "TRC20"){

        return (
            appConfig.networks?.trc20?.address ||
            appConfig.usdtTrc20Address ||
            appConfig.usdt_trc20_address ||
            appConfig.trc20Address ||
            appConfig.trc20_address ||
            appConfig.USDT_TRC20 ||
            ""
        );

    }


    return "";
}


function updateDepositAddress(){

    const address =
        getNetworkAddress(selectedDepositNetwork);

    document.getElementById("depositAddress").value =
        address || "Address not configured";
}


/* =========================================================
   NAVIGATION
========================================================= */

const pageTitles = {

    dashboard:"Dashboard",
    marketplace:"Marketplace",
    "my-nfts":"My NFTs",
    sell:"Sell NFT",
    deposit:"Deposit",
    withdraw:"Withdraw",
    history:"History",
    referral:"Referral",
    profile:"Profile"

};


function openPage(page){

    document.querySelectorAll(".page").forEach(el=>{
        el.classList.remove("active");
    });


    const target =
        document.getElementById("page-" + page);

    if(target){
        target.classList.add("active");
    }


    document.querySelectorAll(".nav-item[data-page]").forEach(el=>{

        el.classList.toggle(
            "active",
            el.dataset.page === page
        );

    });


    document.querySelectorAll(".mobile-nav button[data-page]").forEach(el=>{

        el.classList.toggle(
            "active",
            el.dataset.page === page
        );

    });


    document.getElementById("pageTitle").textContent =
        pageTitles[page] || "Meta NFT";


    if(page === "marketplace"){
        loadNFTs();
    }

    if(page === "my-nfts"){
        loadMyNFTs();
    }

    if(page === "sell"){
        loadSellNFTs();
    }

    if(page === "history"){
        loadHistory();
    }

    if(page === "referral"){
        loadReferral();
    }

}


document.querySelectorAll(".nav-item[data-page]").forEach(button=>{

    button.addEventListener("click",()=>{

        openPage(button.dataset.page);

    });

});


document.querySelectorAll(".mobile-nav button[data-page]").forEach(button=>{

    button.addEventListener("click",()=>{

        openPage(button.dataset.page);

    });

});


/* =========================================================
   DASHBOARD
========================================================= */

async function loadDashboard(){

    try{

        const data = await api("/api/dashboard");

        const dashboard =
            data.dashboard ||
            data.data ||
            data;


        const balance =
            dashboard.balance ??
            dashboard.walletBalance ??
            currentUser?.balance ??
            0;


        document.getElementById("dashboardBalance").textContent =
            money(balance);

        document.getElementById("totalEarnings").textContent =
            money(
             dashboard.totalEarnings ??
dashboard.earnings ??
0
);

document.getElementById("todayEarnings").textContent =
    money(
        dashboard.todayEarnings ??
        0
    );
document.getElementById("referralEarnings").textContent =
    money(
        dashboard.referralEarnings ??
        0
    );


document.getElementById("ownedNFTs").textContent =
    dashboard.ownedNFTs ??
    dashboard.ownedNfts ??
    0;
   document.getElementById("teamCount").textContent =
    dashboard.teamCount ??
    0;



        if(currentUser){

            currentUser.balance =
                balance;

            updateUserUI();

        }


    }catch(error){

        console.error("Dashboard:",error);

    }

}


/* =========================================================
   LOAD NFTS
========================================================= */

async function loadNFTs(){

    const containers = [

        document.getElementById("marketplaceGrid"),
        document.getElementById("dashboardNFTs")

    ];


    containers.forEach(container=>{

        if(container){

            container.innerHTML = `
                <div class="empty" style="grid-column:1/-1;">
                    Loading NFTs...
                </div>
            `;

        }

    });


    try{

        const data = await api("/api/nfts");

        let nfts =
            data.nfts ||
            data.data ||
            data;


        if(!Array.isArray(nfts)){
            nfts = [];
        }


        renderNFTs(
            document.getElementById("marketplaceGrid"),
            nfts
        );


        renderNFTs(
            document.getElementById("dashboardNFTs"),
            nfts.slice(0,3)
        );


    }catch(error){

        containers.forEach(container=>{

            if(container){

                container.innerHTML = `
                    <div class="empty" style="grid-column:1/-1;">
                        <div class="empty-icon">⚠</div>
                        Unable to load NFTs.
                    </div>
                `;

            }

        });

        showToast(error.message,"error");

    }

}


function renderNFTs(container,nfts){

    if(!container){
        return;
    }


    if(!nfts.length){

        container.innerHTML = `
            <div class="empty" style="grid-column:1/-1;">
                <div class="empty-icon">◈</div>
                <strong>No NFTs available</strong>
                <p style="margin-top:7px;">
                    New NFTs will appear here when available.
                </p>
            </div>
        `;

        return;
    }


    container.innerHTML = nfts.map(nft=>{

        const image =
            nft.image_url ||
            nft.imageUrl ||
            "";


        const name =
            nft.name ||
            "Untitled NFT";


        const description =
            nft.description ||
            "Exclusive digital NFT";


        const price =
            Number(nft.price || 0);


        const profitPercent =
            Number(nft.profit_percent || nft.profitPercent || 0);


        return `

            <div class="nft-card">

                <div class="nft-image">

                    ${
                        image
                        ?
                        `<img
                            src="${escapeHtml(image)}"
                            alt="${escapeHtml(name)}"
                            onerror="this.style.display='none';this.parentElement.innerHTML='<div class=\\'nft-placeholder\\'>◈</div>';"
                        >`
                        :
                        `<div class="nft-placeholder">◈</div>`
                    }

                </div>

                <div class="nft-body">

                    <div class="nft-name">
                        ${escapeHtml(name)}
                    </div>

                    <div class="nft-description">
                        ${escapeHtml(description)}
                    </div>

                    <div class="nft-meta">

                        <div class="nft-price">
                            ${money(price)}
                        </div>

                        ${
                            profitPercent > 0
                            ?
                            `<div class="nft-profit">
                                ${profitPercent}% display
                            </div>`
                            :
                            `<div class="nft-profit">
                                NFT
                            </div>`
                        }

                    </div>

                    <button
                        class="btn btn-primary"
                        onclick="openBuyModal(${Number(nft.id)})"
                    >
                        Buy NFT
                    </button>

                </div>

            </div>

        `;

    }).join("");

}


/* =========================================================
   BUY NFT
========================================================= */

async function openBuyModal(nftId){

    try{

        const data = await api("/api/nfts");

        let nfts =
            data.nfts ||
            data.data ||
            data;


        if(!Array.isArray(nfts)){
            nfts = [];
        }


        selectedBuyNFT =
            nfts.find(nft=>Number(nft.id) === Number(nftId));


        if(!selectedBuyNFT){

            showToast("NFT not found.","error");

            return;
        }


        const price =
            Number(selectedBuyNFT.price || 0);


        document.getElementById("buyNFTDetails").innerHTML = `

            <div style="display:flex;gap:15px;align-items:center;">

                <div style="
                    width:90px;
                    height:90px;
                    border-radius:14px;
                    overflow:hidden;
                    background:#eeeaff;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    flex-shrink:0;
                ">

                    ${
                        selectedBuyNFT.image_url
                        ?
                        `<img
                            src="${escapeHtml(selectedBuyNFT.image_url)}"
                            style="width:100%;height:100%;object-fit:cover;"
                        >`
                        :
                        `<span style="font-size:35px;">◈</span>`
                    }

                </div>

                <div>

                    <div style="font-size:18px;font-weight:850;">
                        ${escapeHtml(selectedBuyNFT.name)}
                    </div>

                    <div style="color:#777;font-size:13px;margin-top:5px;">
                        ${escapeHtml(selectedBuyNFT.description || "NFT")}
                    </div>

                    <div style="font-size:20px;font-weight:850;margin-top:9px;">
                        ${money(price)}
                    </div>

                </div>

            </div>

        `;


        document.getElementById("buyModal").classList.add("show");


        document.getElementById("confirmBuyBtn").onclick =
            confirmBuyNFT;


    }catch(error){

        showToast(error.message,"error");

    }

}


function closeBuyModal(){

    document.getElementById("buyModal").classList.remove("show");

    selectedBuyNFT = null;

}


async function confirmBuyNFT(){

    if(!selectedBuyNFT){
        return;
    }


    const button =
        document.getElementById("confirmBuyBtn");

    button.disabled = true;
    button.textContent = "Processing...";


    try{

        const data = await api("/api/reservations",{

            method:"POST",

            body:JSON.stringify({

                nftId:Number(selectedBuyNFT.id)

            })

        });


        if(data.success === false){

            throw new Error(
                data.message || "NFT purchase failed."
            );

        }


        closeBuyModal();

        showToast(
            "NFT purchased successfully.",
            "success"
        );


        await loadDashboard();

        await loadMyNFTs();

        await loadSellNFTs();

        await loadNFTs();

        openPage("my-nfts");


    }catch(error){

        showToast(error.message,"error");

    }finally{

        button.disabled = false;
        button.textContent = "Confirm Purchase";

    }

}


/* =========================================================
   MY NFTS
========================================================= */

async function loadMyNFTs(){

    const container =
        document.getElementById("myNFTsContainer");


    container.innerHTML = `
        <div class="empty" style="grid-column:1/-1;">
            Loading your NFTs...
        </div>
    `;


    try{

        const data = await api("/api/my-nfts");

        let nfts =
            data.nfts ||
            data.userNFTs ||
            data.data ||
            data;


        if(!Array.isArray(nfts)){
            nfts = [];
        }


        renderMyNFTs(container,nfts);


    }catch(error){

        container.innerHTML = `
            <div class="empty" style="grid-column:1/-1;">
                Unable to load your NFTs.
            </div>
        `;

        showToast(error.message,"error");

    }

}


function renderMyNFTs(container,nfts){

    if(!nfts.length){

        container.innerHTML = `
            <div class="card empty" style="grid-column:1/-1;">
                <div class="empty-icon">◆</div>
                <strong>You don't own any NFTs yet.</strong>
                <p style="margin-top:7px;">
                    Visit the marketplace to purchase your first NFT.
                </p>

                <button
                    class="btn btn-primary"
                    style="margin-top:17px;"
                    onclick="openPage('marketplace')"
                >
                    Explore Marketplace
                </button>

            </div>
        `;

        return;
    }


    container.innerHTML = nfts.map(nft=>{

        const image =
            nft.image_url ||
            nft.imageUrl ||
            "";


        const name =
            nft.name ||
            "NFT";


        const purchasePrice =
            Number(nft.purchase_price || 0);


        const salePrice =
            nft.sale_price !== null &&
            nft.sale_price !== undefined
            ?
            Number(nft.sale_price)
            :
            null;


        const profit =
            nft.profit_amount !== null &&
            nft.profit_amount !== undefined
            ?
            Number(nft.profit_amount)
            :
            null;


        const status =
            nft.status ||
            "owned";


        return `

            <div class="card my-nft-card">

                <div class="my-nft-row">

                    <div class="my-nft-thumb">

                        ${
                            image
                            ?
                            `<img
                                src="${escapeHtml(image)}"
                                alt="${escapeHtml(name)}"
                            >`
                            :
                            `<div style="
                                width:100%;
                                height:100%;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                font-size:40px;
                            ">◆</div>`
                        }

                    </div>


                    <div class="my-nft-info">

                        <div style="
                            display:flex;
                            justify-content:space-between;
                            gap:10px;
                            align-items:flex-start;
                        ">

                            <div class="nft-name">
                                ${escapeHtml(name)}
                            </div>

                            <span class="badge ${
                                status === "owned"
                                ? "badge-green"
                                : "badge-yellow"
                            }">
                                ${escapeHtml(status)}
                            </span>

                        </div>


                        <div class="data-row">
                            <span>Purchase Price</span>
                            <strong>${money(purchasePrice)}</strong>
                        </div>


                        <div class="data-row">
                            <span>Purchase Date</span>
                            <strong>${formatDate(nft.purchase_date)}</strong>
                        </div>


                        ${
                            salePrice !== null
                            ?
                            `
                            <div class="data-row">
                                <span>Sale Price</span>
                                <strong>${money(salePrice)}</strong>
                            </div>
                            `
                            :
                            ""
                        }


                        ${
                            profit !== null
                            ?
                            `
                            <div class="data-row">
                                <span>Realized Profit</span>
                                <strong style="color:${profit >= 0 ? "var(--green)" : "var(--red)"}">
                                    ${money(profit)}
                                </strong>
                            </div>
                            `
                            :
                            ""
                        }


                        ${
                            status === "owned"
                            ?
                            `
                            <button
                                class="btn btn-primary"
                                style="margin-top:7px;"
                                onclick="openSellModal(
                                    ${Number(nft.id)},
                                    '${escapeHtml(name).replace(/'/g,"&#039;")}',
                                    ${purchasePrice},
                                    '${escapeHtml(image).replace(/'/g,"&#039;")}'
                                )"
                            >
                                Sell NFT
                            </button>
                            `
                            :
                            ""
                        }

                    </div>

                </div>

            </div>

        `;

    }).join("");

}


/* =========================================================
   SELL NFT
========================================================= */

async function loadSellNFTs(){

    const container =
        document.getElementById("sellNFTContainer");


    container.innerHTML = `
        <div class="empty" style="grid-column:1/-1;">
            Loading...
        </div>
    `;


    try{

        const data = await api("/api/my-nfts");

        let nfts =
            data.nfts ||
            data.userNFTs ||
            data.data ||
            data;


        if(!Array.isArray(nfts)){
            nfts = [];
        }


        nfts =
            nfts.filter(nft =>
                String(nft.status || "").toLowerCase() === "owned"
            );


        if(!nfts.length){

            container.innerHTML = `
                <div class="card empty" style="grid-column:1/-1;">
                    <div class="empty-icon">↗</div>
                    <strong>No NFTs available for sale.</strong>
                    <p style="margin-top:7px;">
                        Purchase an NFT first.
                    </p>
                </div>
            `;

            return;
        }


        container.innerHTML = nfts.map(nft=>{

            const image =
                nft.image_url ||
                nft.imageUrl ||
                "";


            const price =
                Number(nft.purchase_price || 0);


            return `

                <div class="card my-nft-card">

                    <div class="my-nft-row">

                        <div class="my-nft-thumb">

                            ${
                                image
                                ?
                                `<img
                                    src="${escapeHtml(image)}"
                                    alt="${escapeHtml(nft.name || "NFT")}"
                                >`
                                :
                                `<div style="
                                    width:100%;
                                    height:100%;
                                    display:flex;
                                    align-items:center;
                                    justify-content:center;
                                    font-size:40px;
                                ">◆</div>`
                            }

                        </div>


                        <div class="my-nft-info">

                            <div class="nft-name">
                                ${escapeHtml(nft.name || "NFT")}
                            </div>

                            <div class="data-row">
                                <span>Purchase Price</span>
                                <strong>${money(price)}</strong>
                            </div>

                            <div class="data-row">
                                <span>Purchased</span>
                                <strong>${formatDate(nft.purchase_date)}</strong>
                            </div>

                            <button
                                class="btn btn-primary"
                                onclick="openSellModal(
                                    ${Number(nft.id)},
                                    '${escapeHtml(nft.name || "NFT").replace(/'/g,"&#039;")}',
                                    ${price},
                                    '${escapeHtml(image).replace(/'/g,"&#039;")}'
                                )"
                            >
                                Sell NFT
                            </button>

                        </div>

                    </div>

                </div>

            `;

        }).join("");


    }catch(error){

        container.innerHTML = `
            <div class="empty" style="grid-column:1/-1;">
                Unable to load NFTs.
            </div>
        `;

        showToast(error.message,"error");

    }

}


function openSellModal(id,name,purchasePrice,image){

    selectedSellNFT = {

        id,
        name,
        purchasePrice,
        image

    };


    document.getElementById("salePriceInput").value = "";

    document.getElementById("sellNFTDetails").innerHTML = `

        <div style="display:flex;gap:15px;align-items:center;">

            <div style="
                width:80px;
                height:80px;
                border-radius:13px;
                overflow:hidden;
                background:#eeeaff;
                display:flex;
                align-items:center;
                justify-content:center;
                flex-shrink:0;
            ">

                ${
                    image
                    ?
                    `<img
                        src="${escapeHtml(image)}"
                        style="width:100%;height:100%;object-fit:cover;"
                    >`
                    :
                    `<span style="font-size:32px;">◆</span>`
                }

            </div>

            <div>

                <div style="font-size:17px;font-weight:850;">
                    ${escapeHtml(name)}
                </div>

                <div style="font-size:13px;color:#777;margin-top:5px;">
                    Purchase price: ${money(purchasePrice)}
                </div>

            </div>

        </div>

    `;


    updateSellCalculation();


    document.getElementById("sellModal").classList.add("show");


    document.getElementById("confirmSellBtn").onclick =
        confirmSellNFT;

}


function closeSellModal(){

    document.getElementById("sellModal").classList.remove("show");

    selectedSellNFT = null;

}


document.getElementById("salePriceInput").addEventListener(
    "input",
    updateSellCalculation
);


function updateSellCalculation(){

    if(!selectedSellNFT){
        return;
    }


    const salePrice =
        Number(
            document.getElementById("salePriceInput").value || 0
        );


    const profit =
        salePrice - selectedSellNFT.purchasePrice;


    document.getElementById("sellCalculation").innerHTML = `

        Purchase Price:
        <strong>${money(selectedSellNFT.purchasePrice)}</strong>
        <br>

        Sale Price:
        <strong>${money(salePrice)}</strong>
        <br>

        Realized Profit:
        <strong style="color:${profit >= 0 ? "var(--green)" : "var(--red)"}">
            ${money(profit)}
        </strong>

    `;

}


async function confirmSellNFT(){

    if(!selectedSellNFT){
        return;
    }


    const salePrice =
        Number(
            document.getElementById("salePriceInput").value
        );


    if(!salePrice || salePrice <= 0){

        showToast(
            "Please enter a valid sale price.",
            "error"
        );

        return;
    }


    const button =
        document.getElementById("confirmSellBtn");


    button.disabled = true;
    button.textContent = "Selling...";


    try{

        const data = await api(
            "/api/my-nfts/" +
            Number(selectedSellNFT.id) +
            "/sell",
            {

                method:"POST",

                body:JSON.stringify({
                    salePrice
                })

            }
        );


        if(data.success === false){

            throw new Error(
                data.message || "NFT sale failed."
            );

        }


        closeSellModal();

        showToast(
            "NFT sold successfully.",
            "success"
        );


        await loadDashboard();

        await loadMyNFTs();

        await loadSellNFTs();

        await loadHistory();

        openPage("my-nfts");


    }catch(error){

        showToast(error.message,"error");

    }finally{

        button.disabled = false;
        button.textContent = "Sell NFT";

    }

}


/* =========================================================
   DEPOSIT
========================================================= */

function selectDepositNetwork(network){

    selectedDepositNetwork = network;


    document
        .getElementById("depositBep20")
        .classList.toggle(
            "selected",
            network === "BEP20"
        );


    document
        .getElementById("depositTrc20")
        .classList.toggle(
            "selected",
            network === "TRC20"
        );


    updateDepositAddress();

}


async function copyDepositAddress(){

    const input =
        document.getElementById("depositAddress");


    const value = input.value;


    if(!value || value === "Loading..." || value === "Address not configured"){

        showToast(
            "Deposit address is not available.",
            "error"
        );

        return;
    }


    try{

        await navigator.clipboard.writeText(value);

        showToast(
            "Address copied.",
            "success"
        );

    }catch{

        input.select();

        document.execCommand("copy");

        showToast(
            "Address copied.",
            "success"
        );

    }

}


document.getElementById("depositForm").addEventListener(
    "submit",
    async function(e){

        e.preventDefault();


        const amount =
            Number(
                document.getElementById("depositAmount").value
            );


        const txHash =
            document.getElementById("depositTxHash").value.trim();


        if(!amount || amount <= 0){

            showToast(
                "Enter a valid deposit amount.",
                "error"
            );

            return;
        }


        if(!txHash){

            showToast(
                "Enter the transaction hash.",
                "error"
            );

            return;
        }


        const button =
            this.querySelector("button[type=submit]");


        const oldText = button.textContent;

        button.disabled = true;
        button.textContent = "Submitting...";


        try{

            const data = await api("/api/deposits",{

                method:"POST",

                body:JSON.stringify({

                    amount,
                    network:selectedDepositNetwork,
                    txHash

                })

            });


            if(data.success === false){

                throw new Error(
                    data.message || "Deposit request failed."
                );

            }


            showToast(
                data.message ||
                "Deposit request submitted successfully.",
                "success"
            );


            document.getElementById("depositAmount").value = "";

            document.getElementById("depositTxHash").value = "";


            await loadHistory();


        }catch(error){

            showToast(
                error.message,
                "error"
            );

        }finally{

            button.disabled = false;
            button.textContent = oldText;

        }

    }
);


/* =========================================================
   WITHDRAW
========================================================= */

function selectWithdrawNetwork(network){

    selectedWithdrawNetwork = network;


    document
        .getElementById("withdrawBep20")
        .classList.toggle(
            "selected",
            network === "BEP20"
        );


    document
        .getElementById("withdrawTrc20")
        .classList.toggle(
            "selected",
            network === "TRC20"
        );

}


document.getElementById("withdrawForm").addEventListener(
    "submit",
    async function(e){

        e.preventDefault();


        const amount =
            Number(
                document.getElementById("withdrawAmount").value
            );


        const walletAddress =
            document
                .getElementById("withdrawWalletAddress")
                .value
                .trim();


        const currentBalance =
            Number(
                currentUser?.balance || 0
            );


        if(!amount || amount <= 0){

            showToast(
                "Enter a valid withdrawal amount.",
                "error"
            );

            return;
        }


        if(amount > currentBalance){

            showToast(
                "Insufficient balance.",
                "error"
            );

            return;
        }


        if(!walletAddress){

            showToast(
                "Enter your wallet address.",
                "error"
            );

            return;
        }


        const button =
            this.querySelector("button[type=submit]");


        const oldText = button.textContent;

        button.disabled = true;
        button.textContent = "Submitting...";


        try{

            const data = await api("/api/withdrawals",{

                method:"POST",

                body:JSON.stringify({

                    amount,

                    network:selectedWithdrawNetwork,

                    walletAddress

                })

            });


            if(data.success === false){

                throw new Error(
                    data.message ||
                    "Withdrawal request failed."
                );

            }


            showToast(
                data.message ||
                "Withdrawal request submitted successfully.",
                "success"
            );


            document.getElementById("withdrawAmount").value = "";

            document.getElementById("withdrawWalletAddress").value = "";


            await loadDashboard();

            await loadHistory();


        }catch(error){

            showToast(
                error.message,
                "error"
            );

        }finally{

            button.disabled = false;
            button.textContent = oldText;

        }

    }
);


/* =========================================================
   HISTORY
========================================================= */

async function loadHistory(){

    const tbody =
        document.getElementById("historyTableBody");


    tbody.innerHTML = `
        <tr>
            <td colspan="5" style="text-align:center;">
                Loading history...
            </td>
        </tr>
    `;


    try{

        const data = await api("/api/history");


        let deposits =
            Array.isArray(data.deposits)
            ?
            data.deposits
            :
            [];


        let withdrawals =
            Array.isArray(data.withdrawals)
            ?
            data.withdrawals
            :
            [];


        let earnings =
            Array.isArray(data.earnings)
            ?
            data.earnings
            :
            [];


        const rows = [];


        deposits.forEach(item=>{

            rows.push({

                date:item.created_at,

                type:"Deposit",

                network:item.network || "-",

                amount:Number(item.amount || 0),

                status:item.status || "pending"

            });

        });


        withdrawals.forEach(item=>{

            rows.push({

                date:item.created_at,

                type:"Withdrawal",

                network:item.network || "-",

                amount:Number(item.amount || 0),

                status:item.status || "pending"

            });

        });


        earnings.forEach(item=>{

            rows.push({

                date:item.created_at,

                type:
                    item.type ||
                    "Earning",

                network:"-",

                amount:Number(item.amount || 0),

                status:item.status || "completed"

            });

        });


        rows.sort((a,b)=>{

            return new Date(b.date) - new Date(a.date);

        });


        if(!rows.length){

            tbody.innerHTML = `
                <tr>
                    <td colspan="5" style="text-align:center;padding:40px;">
                        No transaction history yet.
                    </td>
                </tr>
            `;

            return;
        }


        tbody.innerHTML = rows.map(item=>{

            const status =
                String(item.status).toLowerCase();


            let badgeClass = "badge-yellow";


            if(
                status === "approved" ||
                status === "completed"
            ){
                badgeClass = "badge-green";
            }


            if(status === "rejected"){
                badgeClass = "badge-red";
            }


            const typeName =
                String(item.type)
                    .replaceAll("_"," ")
                    .replace(/\b\w/g,c=>c.toUpperCase());


            return `

                <tr>

                    <td>
                        ${formatDate(item.date)}
                    </td>

                    <td>
                        <strong>
                            ${escapeHtml(typeName)}
                        </strong>
                    </td>

                    <td>
                        ${escapeHtml(item.network)}
                    </td>

                    <td>
                        ${money(item.amount)}
                    </td>

                    <td>
                        <span class="badge ${badgeClass}">
                            ${escapeHtml(status)}
                        </span>
                    </td>

                </tr>

            `;

        }).join("");


    }catch(error){

        tbody.innerHTML = `
            <tr>
                <td colspan="5" style="text-align:center;padding:40px;">
                    Unable to load history.
                </td>
            </tr>
        `;

        console.error(error);

    }

}


/* =========================================================
   REFERRAL
========================================================= */

async function loadReferral(){

    try{
        const data = await api("/api/referral");


        document.getElementById("referralCode").textContent =
            data.referralCode || "-";


        document.getElementById("referralLink").value =
            data.referralLink || "";


        document.getElementById("referralPercent").textContent =
            Number(data.bonusPercent || 10) + "%";


        document.getElementById("teamCount").textContent =
            data.teamCount || 0;


        document.getElementById("totalReferralBonus").textContent =
            money(data.totalBonus || 0);


        document.getElementById("profileReferral").textContent =
            data.referralCode || "-";


    }catch(error){

        console.error("Referral:",error);

    }

}


async function copyReferralLink(){

    const input =
        document.getElementById("referralLink");


    if(!input.value){

        showToast(
            "Referral link is not available.",
            "error"
        );

        return;
    }


    try{

        await navigator.clipboard.writeText(input.value);

        showToast(
            "Referral link copied.",
            "success"
        );

    }catch{

        input.select();

        document.execCommand("copy");

        showToast(
            "Referral link copied.",
            "success"
        );

    }

}


/* =========================================================
   LOGOUT
========================================================= */

async function logout(){

    try{

        await api("/api/logout",{
            method:"POST"
        });

    }catch(error){

        console.error(error);

    }


    currentUser = null;


    document.getElementById("dashboardApp")
        .classList.remove("active");


    document.getElementById("authPage").style.display =
        "flex";


    document.getElementById("loginPassword").value = "";


    showLogin();


    showToast(
        "Logged out successfully.",
        "success"
    );

}


/* =========================================================
   INITIAL SESSION CHECK
========================================================= */

async function checkExistingSession(){

    try{

        const data = await api("/api/me");


        if(
            data &&
            (
                data.success !== false ||
                data.user
            )
        ){

            currentUser =
                data.user ||
                data.data ||
                data;


            if(currentUser && currentUser.id){

                await startApplication();

                return;
            }

        }

    }catch(error){

        console.log("No active session.");

    }


    document.getElementById("authPage").style.display =
        "flex";

}


/* =========================================================
   MODAL BACKGROUND CLOSE
========================================================= */

document.getElementById("buyModal").addEventListener(
    "click",
    function(e){

        if(e.target === this){
            closeBuyModal();
        }

    }
);


document.getElementById("sellModal").addEventListener(
    "click",
    function(e){

        if(e.target === this){
            closeSellModal();
        }

    }
);


/* =========================================================
   START
========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    checkExistingSession
);
/* =========================================================
   REGISTRATION EMAIL OTP
========================================================= */

let registrationOtpTimer = null;
let registrationOtpSeconds = 0;


async function sendRegistrationOTP(){

    const emailInput =
        document.getElementById("registerEmail");

    const button =
        document.getElementById("registerSendOtpBtn");

    const message =
        document.getElementById("registerOtpMessage");


    const email =
        String(
            emailInput?.value || ""
        ).trim();


    if(!email){

        message.textContent =
            "Please enter your email address.";

        message.style.color =
            "#dc2626";

        emailInput?.focus();

        return;
    }


    /* Basic email check */

    const emailPattern =
        /^[^\s@]+@[^\s@]+\.[^\s@]+$/;


    if(!emailPattern.test(email)){

        message.textContent =
            "Please enter a valid email address.";

        message.style.color =
            "#dc2626";

        emailInput?.focus();

        return;
    }


    button.disabled = true;

    button.textContent =
        "Sending...";

    message.textContent =
        "";


    try{

        const response =
            await fetch(
                "/api/register/send-otp",
                {
                    method:"POST",

                    headers:{
                        "Content-Type":
                            "application/json"
                    },

                    body:JSON.stringify({
                        email:email
                    })
                }
            );


        const data =
            await response.json();


        if(!response.ok || !data.success){

            throw new Error(
                data.message ||
                "Unable to send OTP."
            );
        }


        message.textContent =
            "OTP sent successfully. Please check your email.";

        message.style.color =
            "#16a34a";


        startRegistrationOtpTimer();


    }catch(error){

        console.error(
            "Registration OTP:",
            error
        );


        message.textContent =
            error.message ||
            "Unable to send OTP.";

        message.style.color =
            "#dc2626";


        button.disabled = false;

        button.textContent =
            "Send OTP";
    }
}


/* =========================================================
   OTP COUNTDOWN
========================================================= */

function startRegistrationOtpTimer(){

    const button =
        document.getElementById(
            "registerSendOtpBtn"
        );


    registrationOtpSeconds =
        60;


    if(registrationOtpTimer){

        clearInterval(
            registrationOtpTimer
        );
    }


    button.disabled = true;


    button.textContent =
        `Resend (${registrationOtpSeconds}s)`;


    registrationOtpTimer =
        setInterval(
            function(){

                registrationOtpSeconds--;


                if(
                    registrationOtpSeconds <= 0
                ){

                    clearInterval(
                        registrationOtpTimer
                    );

                    registrationOtpTimer =
                        null;


                    button.disabled =
                        false;

                    button.textContent =
                        "Resend OTP";

                    return;
                }


                button.textContent =
                    `Resend (${registrationOtpSeconds}s)`;

            },
            1000
        );
}
</script>

</body>
</html>
