        padding:5px;
        border-radius:19px;
        background:rgba(255,255,255,.96);
        border:1px solid rgba(108,77,246,.10);
        box-shadow:
            0 15px 38px rgba(15,23,42,.14),
            0 5px 15px rgba(108,77,246,.055);
        backdrop-filter:blur(18px);
        -webkit-backdrop-filter:blur(18px);
    }

