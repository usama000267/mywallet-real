<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Meta NFT</title>

<style>
    
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

:root{
    --primary:#6c4df6;
    --primary2:#8b5cf6;
    --cyan:#06b6d4;
    --dark:#17142b;
    --muted:#73758a;
    --bg:#f7f7fb;
    --white:#ffffff;
    --border:#e9e8f2;
    --green:#16a34a;
    --red:#dc2626;
    --yellow:#d97706;
    --shadow:0 12px 35px rgba(34,27,72,.08);
}

body{
    font-family:Inter,Arial,Helvetica,sans-serif;
    background:
        radial-gradient(
            circle at 0% 0%,
            rgba(108,77,246,.045),
            transparent 28%
        ),
        radial-gradient(
            circle at 100% 100%,
            rgba(6,182,212,.045),
            transparent 30%
        ),
        var(--bg);
    color:var(--dark);
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
    -moz-osx-font-smoothing:grayscale;
    text-rendering:optimizeLegibility;
}

button,
input,
select{
    font:inherit;
}

button{
    cursor:pointer;
}

.hidden{
    display:none!important;
}

.app{
    min-height:100vh;
}

/* ================= AUTH ================= */

.auth-page{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:25px;
    background:
        radial-gradient(circle at 10% 10%,rgba(108,77,246,.15),transparent 30%),
        radial-gradient(circle at 90% 90%,rgba(6,182,212,.12),transparent 30%),
        #f8f8fc;
}

.auth-box{
    width:100%;
    max-width:450px;
    background:#fff;
    border:1px solid var(--border);
    border-radius:26px;
    box-shadow:var(--shadow);
    padding:35px;
}

.logo{
    display:flex;
    align-items:center;
    gap:11px;
    font-size:23px;
    font-weight:800;
    color:var(--dark);
}

.logo-icon{
    width:42px;
    height:42px;
    border-radius:13px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#fff;
    font-weight:900;
    background:linear-gradient(135deg,var(--primary),var(--cyan));
    box-shadow:0 8px 20px rgba(108,77,246,.25);
}

.auth-logo{
    justify-content:center;
    margin-bottom:25px;
}

.auth-title{
    text-align:center;
    font-size:28px;
    margin-bottom:8px;
}

.auth-subtitle{
    text-align:center;
    color:var(--muted);
    font-size:14px;
    margin-bottom:25px;
}

.form-group{
    margin-bottom:19px;
}
.form-group label{
    display:block;
    margin-bottom:8px;
    font-size:13px;
    line-height:1.4;
    font-weight:750;
    color:#374151;
    letter-spacing:.05px;
}
.form-control{
    width:100%;
    border:1px solid rgba(15,23,42,.10);
    background:rgba(248,250,252,.94);
    border-radius:14px;
    padding:13px 15px;
    min-height:47px;
    outline:none;
    color:var(--dark);
    font-size:14px;
    font-weight:500;
    line-height:1.4;
    transition:
        border-color .22s ease,
        box-shadow .22s ease,
        background .22s ease,
        transform .22s ease;
    box-sizing:border-box;
    -webkit-appearance:none;
    appearance:none;
}

.form-control::placeholder{
    color:#9aa0b2;
    opacity:.9;
}

.form-control:focus{
    background:#fff;
    border-color:rgba(108,77,246,.55);
    box-shadow:
        0 0 0 4px rgba(108,77,246,.09),
        0 8px 20px rgba(15,23,42,.04);
    transform:translateY(-1px);
}

.btn{
    border:0;
    border-radius:13px;
    padding:12px 18px;
    min-height:44px;
    font-weight:750;
    letter-spacing:.1px;
    transition:
        transform .22s ease,
        box-shadow .22s ease,
        background .22s ease,
        opacity .22s ease;
    -webkit-tap-highlight-color:transparent;
}

.btn:hover{
    transform:translateY(-2px);
}

.btn:active{
    transform:translateY(0);
}

.btn:disabled{
    cursor:not-allowed;
    opacity:.65;
    transform:none;
}

.btn-primary{
    color:#fff;
    background:linear-gradient(
        135deg,
        var(--primary),
        var(--primary2),
        var(--cyan)
    );
    background-size:160% 160%;
    box-shadow:
        0 9px 22px rgba(108,77,246,.20),
        0 3px 8px rgba(6,182,212,.08);
    border:1px solid rgba(255,255,255,.18);
}

.btn-primary:hover{
    background-position:100% 50%;
    box-shadow:
        0 13px 28px rgba(108,77,246,.24),
        0 5px 12px rgba(6,182,212,.10);
}
.btn-secondary{
    color:var(--dark);
    background:linear-gradient(
        135deg,
        #f4f1ff,
        #eef8ff
    );
    border:1px solid rgba(108,77,246,.10);
    box-shadow:0 5px 14px rgba(15,23,42,.05);
}

.btn-secondary:hover{
    color:var(--primary);
    background:linear-gradient(
        135deg,
        #eeeaff,
        #e7f8ff
    );
    border-color:rgba(108,77,246,.16);
    box-shadow:0 9px 20px rgba(15,23,42,.08);
}
.btn-danger{
    color:#fff;
    background:var(--red);
}

.btn-success{
    color:#fff;
    background:var(--green);
}

.btn-full{
    width:100%;
}

.auth-switch{
    margin-top:20px;
    text-align:center;
    color:var(--muted);
    font-size:14px;
}

.auth-switch button{
    border:0;
    background:none;
    color:var(--primary);
    font-weight:800;
}

.auth-message{
    padding:11px 13px;
    border-radius:10px;
    font-size:13px;
    margin-bottom:15px;
    display:none;
}

.auth-message.error{
    display:block;
    background:#fff0f0;
    color:var(--red);
}

.auth-message.success{
    display:block;
    background:#effdf3;
    color:var(--green);
}

/* ================= LAYOUT ================= */

.dashboard-app{
    display:none;
    min-height:100vh;
}

.dashboard-app.active{
    display:flex;
}.sidebar{
    width:250px;
    background:
        linear-gradient(
            180deg,
            rgba(255,255,255,.99),
            rgba(248,247,255,.98)
        );
    border-right:1px solid rgba(15,23,42,.07);
    position:fixed;
    top:0;
    left:0;
    bottom:0;
    z-index:100;
    padding:22px 15px;
    box-shadow:
        8px 0 30px rgba(15,23,42,.04),
        1px 0 0 rgba(255,255,255,.8);
    backdrop-filter:blur(14px);
    -webkit-backdrop-filter:blur(14px);
}.sidebar-logo{
    padding:8px 10px 26px;
}
.nav{
    display:flex;
    flex-direction:column;
    gap:8px;
}.nav-item{
    width:100%;
    border:1px solid transparent;
    background:transparent;
    color:#686a7c;
    display:flex;
    align-items:center;
    gap:12px;
    padding:12px 14px;
    min-height:45px;
    border-radius:13px;
    text-align:left;
    font-weight:650;
    transition:
        background .22s ease,
        color .22s ease,
        border-color .22s ease,
        transform .22s ease,
        box-shadow .22s ease;
    -webkit-tap-highlight-color:transparent;
}
.nav-item:hover{
    background:linear-gradient(
        135deg,
        rgba(108,77,246,.09),
        rgba(6,182,212,.065)
    );
    color:var(--primary);
    border-color:rgba(108,77,246,.10);
    transform:translateX(2px);
    box-shadow:
        0 5px 14px rgba(108,77,246,.045);
}
.nav-item.active{
    background:linear-gradient(
        135deg,
        rgba(108,77,246,.15),
        rgba(6,182,212,.09)
    );
    color:var(--primary);
    border-color:rgba(108,77,246,.12);
    box-shadow:
        0 7px 18px rgba(108,77,246,.08),
        inset 0 1px 0 rgba(255,255,255,.65);
}



.nav-icon{
    width:21px;
    text-align:center;
    font-size:17px;
}

.sidebar-bottom{
    position:absolute;
    left:15px;
    right:15px;
    bottom:20px;
}

.logout-btn{
    color:#dc2626;
}
.main{
    margin-left:250px;
    width:calc(100% - 250px);
    min-height:100vh;
    background:transparent;
    padding-bottom:40px;
}
.topbar{
    height:76px;
    background:
        linear-gradient(
            180deg,
            rgba(255,255,255,.99),
            rgba(250,251,255,.97)
        );
    border-bottom:1px solid rgba(15,23,42,.07);
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 30px;
    position:sticky;
    top:0;
    z-index:50;
    box-shadow:
        0 8px 26px rgba(15,23,42,.045),
        0 1px 0 rgba(255,255,255,.9);
    backdrop-filter:blur(18px);
    -webkit-backdrop-filter:blur(18px);
    box-sizing:border-box;
}
.topbar-title{
    font-size:21px;
    font-weight:800;
}

.user-mini{
    display:flex;
    align-items:center;
    gap:10px;
}

.avatar{
    width:38px;
    height:38px;
    border-radius:50%;
    background:linear-gradient(135deg,var(--primary),var(--cyan));
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:800;
}
.content{
    padding:32px;
    max-width:1500px;
    margin:0 auto;
    width:100%;
    box-sizing:border-box;
}
.page{
    display:none;
}

.page.active{
    display:block;
}

/* ================= DASHBOARD ================= */

.welcome-card{
    border-radius:22px;
    padding:28px;
    color:#fff;
    background:
        radial-gradient(circle at 90% 20%,rgba(255,255,255,.2),transparent 25%),
        linear-gradient(135deg,#5d43e8,#7c52ed 55%,#0ea5c8);
    box-shadow:0 15px 35px rgba(108,77,246,.18);
    margin-bottom:22px;
}

.welcome-card h1{
    font-size:28px;
    margin-bottom:8px;
}

.welcome-card p{
    opacity:.9;
    font-size:14px;
}
.balance-card{
    margin-top:22px;
    background:linear-gradient(
        135deg,
        rgba(255,255,255,.18),
        rgba(255,255,255,.08)
    );
    border:1px solid rgba(255,255,255,.24);
    padding:18px 20px;
    border-radius:18px;
    width:max-content;
    min-width:260px;
    box-shadow:
        0 10px 28px rgba(15,23,42,.10),
        inset 0 1px 0 rgba(255,255,255,.18);
    backdrop-filter:blur(12px);
    -webkit-backdrop-filter:blur(12px);
}
.balance-label{
    font-size:12px;
    line-height:1.4;
    font-weight:650;
    letter-spacing:.2px;
    opacity:.88;
    color:rgba(255,255,255,.92);
}
.balance-value{
    font-size:30px;
    line-height:1.2;
    font-weight:850;
    letter-spacing:-.5px;
    margin-top:5px;
    color:#ffffff;
    text-shadow:0 2px 10px rgba(0,0,0,.10);
}
.stats-grid{
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:20px;
    margin-bottom:28px;
    width:100%;
}
.stat-card{
    position:relative;
    background:rgba(255,255,255,.98);
    border:1px solid rgba(15,23,42,.07);
    border-radius:20px;
    padding:22px;
    box-shadow:
        0 10px 30px rgba(15,23,42,.05),
        0 2px 8px rgba(15,23,42,.025);
    overflow:hidden;
    transition:
        transform .25s ease,
        box-shadow .25s ease,
        border-color .25s ease;
    min-width:0;
    box-sizing:border-box;
}
.stat-card:hover{
    transform:translateY(-3px);
    border-color:rgba(108,77,246,.12);
    box-shadow:
        0 14px 34px rgba(15,23,42,.07),
        0 4px 12px rgba(108,77,246,.035);
}

.stat-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:17px;
}
.stat-icon{
    width:44px;
    height:44px;
    border-radius:13px;
    background:linear-gradient(
        135deg,
        #f0edff,
        #eef8ff
    );
    color:var(--primary);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:19px;
    border:1px solid rgba(108,77,246,.08);
    box-shadow:
        0 5px 14px rgba(108,77,246,.07),
        inset 0 1px 0 rgba(255,255,255,.85);
    flex-shrink:0;
}
.stat-title{
    color:#6b7280;
    font-size:13px;
    line-height:1.45;
    font-weight:650;
    letter-spacing:.15px;
    margin-top:2px;
}
.stat-value{
    font-size:27px;
    line-height:1.2;
    font-weight:850;
    letter-spacing:-.5px;
    color:#0f172a;
    margin-top:3px;
    font-variant-numeric:tabular-nums;
}
/* ================= SECTION ================= */
.section-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    margin-bottom:20px;
}.section-title{
    font-size:23px;
    line-height:1.25;
    font-weight:800;
    letter-spacing:-.3px;
    color:#0f172a;
}
.section-subtitle{
    color:#7a8192;
    font-size:13px;
    line-height:1.55;
    margin-top:6px;
    font-weight:550;
    letter-spacing:.05px;
}
.card{
    background:rgba(255,255,255,.985);
    border:1px solid rgba(15,23,42,.07);
    border-radius:21px;
    box-shadow:
        0 12px 32px rgba(15,23,42,.05),
        0 3px 10px rgba(108,77,246,.025);
    transition:
        box-shadow .25s ease,
        border-color .25s ease,
        transform .25s ease;
    box-sizing:border-box;
    overflow:hidden;
}

.card:hover{
    border-color:rgba(108,77,246,.14);
    box-shadow:
        0 17px 42px rgba(15,23,42,.075),
        0 5px 15px rgba(108,77,246,.04);
    transform:translateY(-2px);
}
/* ================= NFT ================= */

.nft-grid{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:24px;
    width:100%;
    align-items:stretch;
}

.nft-card{
    position:relative;
    background:rgba(255,255,255,.98);
    border:1px solid rgba(15,23,42,.08);
    border-radius:22px;
    overflow:hidden;
    box-shadow:
        0 10px 30px rgba(15,23,42,.06),
        0 2px 8px rgba(15,23,42,.04);
    transition:
        transform .25s ease,
        box-shadow .25s ease,
        border-color .25s ease;
    min-width:0;
}

.nft-card:hover{
    transform:translateY(-5px);
    border-color:rgba(99,102,241,.18);
    box-shadow:
        0 18px 45px rgba(15,23,42,.10),
        0 5px 15px rgba(99,102,241,.06);
}

.nft-image{
    position:relative;
    width:100%;
    height:250px;
    background:
        linear-gradient(135deg,#f1f5f9,#eef2ff);
    overflow:hidden;
    display:flex;
    align-items:center;
    justify-content:center;
}

.nft-image img{
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center;
    image-rendering:auto;
    transition:transform .35s ease;
}

.nft-card:hover .nft-image img{
    transform:scale(1.025);
}

.nft-placeholder{
    font-size:55px;
    opacity:.65;
}

.nft-body{
    padding:20px;
}

.nft-name{
    font-size:18px;
    line-height:1.3;
    font-weight:800;
    color:#0f172a;
    margin-bottom:7px;
}

.nft-description{
    color:var(--muted);
    font-size:13px;
    line-height:1.6;
    min-height:42px;
    margin-bottom:16px;
}

.nft-meta{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    margin-bottom:17px;
}

.nft-price{
    font-size:21px;
    line-height:1.2;
    font-weight:850;
    color:#0f172a;
}

.nft-profit{
    font-size:12px;
    font-weight:750;
    white-space:nowrap;
    padding:6px 10px;
    border-radius:10px;
    color:var(--green);
    background:#ecfdf3;
    border:1px solid rgba(22,163,74,.10);
}

.nft-card .btn{
    width:100%;
    min-height:46px;
    border-radius:12px;
    font-weight:750;
}

/* Smooth single-page NFT scrolling */
#page-marketplace{
    width:100%;
}

#marketplaceGrid{
    width:100%;
    padding-bottom:30px;
}

/* Tablet */
@media (max-width:1100px){
    .nft-grid{
        grid-template-columns:repeat(2,minmax(0,1fr));
        gap:20px;
    }

    .nft-image{
        height:230px;
    }
}

/* Mobile */
@media (max-width:600px){
    .nft-grid{
        grid-template-columns:repeat(2,minmax(0,1fr));
        gap:12px;
    }

    .nft-card{
        border-radius:16px;
    }

    .nft-image{  
    height:145px;
    border-radius: 0;
    }


    .nft-body{
        padding:11px;
    }

    .nft-name{
    font-size:13px;
    line-height:1.3;
    font-weight:800;
    margin-bottom:6px;
}

    .nft-description{
    font-size:10px;
    line-height:1.45;
    min-height:30px;
    margin-bottom:9px;
    display:-webkit-box;
    -webkit-line-clamp:2;
    line-clamp:2;
    -webkit-box-orient:vertical;
    overflow:hidden;
}

   .nft-price{
    font-size:15px;
    line-height:1.2;
    font-weight:850;
}

.nft-profit{
    font-size:9px;
    line-height:1;
    padding:5px 6px;
    border-radius:8px;
}

    .nft-meta{
    margin-bottom:10px;
    gap:5px;
    align-items:center;
}

    .nft-card .btn{
    min-height:38px;
    padding:8px 6px;
    font-size:11px;
    border-radius:10px;
    font-weight:800;
}
}
/* ================= MY NFT ================= */

.my-nft-list{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:18px;
}
.my-nft-card{
    padding:19px;
    background:rgba(255,255,255,.985);
    border:1px solid rgba(15,23,42,.07);
    border-radius:20px;
    box-shadow:
        0 10px 28px rgba(15,23,42,.05),
        0 3px 9px rgba(108,77,246,.025);
    transition:
        transform .25s ease,
        box-shadow .25s ease,
        border-color .25s ease;
}

.my-nft-card:hover{
    transform:translateY(-3px);
    border-color:rgba(108,77,246,.13);
    box-shadow:
        0 16px 38px rgba(15,23,42,.075),
        0 5px 14px rgba(108,77,246,.035);
}

.my-nft-row{
    display:flex;
    align-items:flex-start;
    gap:16px;
}

.my-nft-thumb{
    width:110px;
    height:110px;
    border-radius:16px;
    overflow:hidden;
    background:
        linear-gradient(
            135deg,
            #f1eeff,
            #eefaff
        );
    border:1px solid rgba(108,77,246,.08);
    box-shadow:
        0 7px 18px rgba(15,23,42,.07);
    flex-shrink:0;
}

.my-nft-thumb img{
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center;
    image-rendering:auto;
    transition:transform .3s ease;
}

.my-nft-card:hover .my-nft-thumb img{
    transform:scale(1.025);
}
.my-nft-info{
    flex:1;
    min-width:0;
    display:flex;
    flex-direction:column;
    gap:7px;
}
.badge{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:29px;
    padding:6px 11px;
    border-radius:10px;
    font-size:11px;
    line-height:1;
    font-weight:800;
    letter-spacing:.15px;
    white-space:nowrap;
    border:1px solid transparent;
    box-sizing:border-box;
    transition:
        background .2s ease,
        border-color .2s ease,
        transform .2s ease;
}
.badge-green{
    color:#15803d;
    background:linear-gradient(
        135deg,
        #ecfdf3,
        #d1fae5
    );
    border-color:rgba(22,163,74,.18);
    box-shadow:0 4px 10px rgba(22,163,74,.07);
}

.badge-yellow{
    color:#a16207;
    background:linear-gradient(
        135deg,
        #fffbeb,
        #fef3c7
    );
    border-color:rgba(245,158,11,.20);
    box-shadow:0 4px 10px rgba(245,158,11,.07);
}

.badge-red{
    color:#b91c1c;
    background:linear-gradient(
        135deg,
        #fff1f2,
        #fecaca
    );
    border-color:rgba(220,38,38,.18);
    box-shadow:0 4px 10px rgba(220,38,38,.07);
}
/* ================= FORMS ================= */
.form-card{
    padding:26px;
    max-width:700px;
    background:rgba(255,255,255,.985);
    border:1px solid rgba(15,23,42,.07);
    border-radius:21px;
    box-shadow:
        0 14px 36px rgba(15,23,42,.055),
        0 4px 12px rgba(108,77,246,.025);
    box-sizing:border-box;
}.network-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:16px;
    margin-bottom:20px;
    width:100%;
}
.network-option{
    position:relative;
    border:1px solid rgba(15,23,42,.08);
    background:linear-gradient(
        135deg,
        #ffffff,
        #f8f7ff
    );
    padding:17px;
    border-radius:16px;
    text-align:left;
    cursor:pointer;
    box-shadow:
        0 8px 22px rgba(15,23,42,.045),
        0 2px 7px rgba(108,77,246,.025);
    transition:
        transform .22s ease,
        border-color .22s ease,
        background .22s ease,
        box-shadow .22s ease;
    box-sizing:border-box;
}

.network-option:hover{
    transform:translateY(-2px);
    border-color:rgba(108,77,246,.18);
    box-shadow:
        0 10px 24px rgba(108,77,246,.07);
}
.network-option.selected{
    border-color:rgba(108,77,246,.45);
    background:linear-gradient(
        135deg,
        #f1eeff,
        #eefaff
    );
    box-shadow:
        0 10px 26px rgba(108,77,246,.11),
        inset 0 1px 0 rgba(255,255,255,.85);
    transform:translateY(-1px);
}
.network-option strong{
    display:block;
    font-size:14px;
    line-height:1.35;
    font-weight:800;
    color:#172033;
    letter-spacing:.05px;
}.network-option span{
    display:block;
    color:#7b8190;
    font-size:11px;
    line-height:1.45;
    margin-top:6px;
    font-weight:550;
}.address-box{
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:20px;
    padding:7px;
    background:linear-gradient(
        135deg,
        #f8f7ff,
        #f3fbff
    );
    border:1px solid rgba(15,23,42,.08);
    border-radius:16px;
    box-shadow:
        0 8px 22px rgba(15,23,42,.045),
        inset 0 1px 0 rgba(255,255,255,.8);
    box-sizing:border-box;
}
.address-box input{
    flex:1;
    min-width:0;
    border:0;
    background:transparent;
    box-shadow:none;
    min-height:44px;
    padding:11px 12px;
    color:#172033;
    font-size:12px;
    font-weight:600;
    outline:none;
    box-sizing:border-box;
}

.address-box input:focus{
    border:0;
    background:transparent;
    box-shadow:none;
    transform:none;
}
.copy-btn{
    white-space:nowrap;
    min-height:44px;
    padding:10px 16px;
    border:1px solid rgba(108,77,246,.13);
    border-radius:13px;
    background:linear-gradient(
        135deg,
        #f1eeff,
        #eefaff
    );
    color:var(--primary);
    font-size:12px;
    font-weight:800;
    box-shadow:
        0 6px 16px rgba(108,77,246,.065);
    cursor:pointer;
    transition:
        transform .2s ease,
        background .2s ease,
        box-shadow .2s ease,
        border-color .2s ease;
}

.copy-btn:hover{
    transform:translateY(-2px);
    background:linear-gradient(
        135deg,
        #e9e5ff,
        #e5f8ff
    );
    border-color:rgba(108,77,246,.20);
    box-shadow:
        0 9px 20px rgba(108,77,246,.09);
}

.copy-btn:active{
    transform:scale(.97);
}
/* ================= HISTORY ================= */
.table-wrap{
    overflow:auto;
    width:100%;
    border-radius:18px;
    -webkit-overflow-scrolling:touch;
    scrollbar-width:thin;
    scrollbar-color:rgba(108,77,246,.28) transparent;
    background:rgba(255,255,255,.98);
    border:1px solid rgba(15,23,42,.06);
    box-shadow:
        0 12px 32px rgba(15,23,42,.05),
        0 4px 12px rgba(108,77,246,.025);
}

.table-wrap::-webkit-scrollbar{
    height:7px;
}

.table-wrap::-webkit-scrollbar-track{
    background:transparent;
}

.table-wrap::-webkit-scrollbar-thumb{
    background:linear-gradient(
        90deg,
        rgba(108,77,246,.28),
        rgba(6,182,212,.25)
    );
    border-radius:20px;
}

table{
    width:100%;
    border-collapse:separate;
    border-spacing:0;
    min-width:700px;
    background:#fff;
}

th,
td{
    padding:15px 15px;
    text-align:left;
    border-bottom:1px solid rgba(15,23,42,.055);
    font-size:13px;
    color:var(--dark);
    line-height:1.45;
    vertical-align:middle;
}

th{
    background:linear-gradient(
        135deg,
        #f8f7ff,
        #f4fbff
    );
    color:#697386;
    font-size:11px;
    font-weight:800;
    letter-spacing:.3px;
    text-transform:uppercase;
    padding:14px 15px;
    border-bottom:1px solid rgba(108,77,246,.09);
    white-space:nowrap;
}

td{
    background:rgba(255,255,255,.98);
}

tbody tr{
    transition:
        background .2s ease,
        transform .2s ease;
}

tbody tr:hover td{
    background:#fafaff;
}

tbody tr:last-child td{
    border-bottom:0;
}
tbody tr{
    transition:
        background .2s ease,
        transform .2s ease;
}

tbody tr:hover td{
    background:#fafaff;
}

/* ================= REFERRAL ================= */

.referral-card{
    padding:25px;
}

.referral-code{
    background:#f5f3ff;
    border:1px dashed var(--primary);
    padding:16px;
    border-radius:14px;
    font-size:20px;
    font-weight:850;
    text-align:center;
    color:var(--primary);
    margin:15px 0;
}

.referral-link{
    display:flex;
    gap:8px;
}

.referral-link input{
    flex:1;
}

/* ================= PROFILE ================= */

.profile-card{
    max-width:700px;
    padding:25px;
}

.profile-avatar{
    width:75px;
    height:75px;
    border-radius:22px;
    background:linear-gradient(135deg,var(--primary),var(--cyan));
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:28px;
    font-weight:850;
    margin-bottom:18px;
}

/* ================= MODAL ================= */

.modal{
    position:fixed;
    inset:0;
    background:rgba(10,8,25,.5);
    z-index:500;
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
}

.modal.show{
    display:flex;
}

.modal-box{
    background:#fff;
    border-radius:20px;
    width:100%;
    max-width:470px;
    padding:25px;
    box-shadow:0 20px 60px rgba(0,0,0,.18);
}

.modal-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:18px;
}

.modal-head h3{
    font-size:20px;
}

.close-btn{
    border:0;
    background:#f1f1f5;
    width:34px;
    height:34px;
    border-radius:50%;
}

/* ================= TOAST ================= */

.toast{
    position:fixed;
    right:20px;
    bottom:20px;
    z-index:1000;
    min-width:260px;
    max-width:380px;
    padding:14px 17px;
    border-radius:15px;
    background:linear-gradient(
        135deg,
        #17142b,
        #24203f
    );
    color:#fff;
    border:1px solid rgba(255,255,255,.10);
    box-shadow:
        0 18px 45px rgba(15,23,42,.18),
        0 5px 15px rgba(15,23,42,.08);
    display:none;
    font-size:13px;
    line-height:1.45;
    font-weight:600;
    backdrop-filter:blur(12px);
    -webkit-backdrop-filter:blur(12px);
}

.toast.show{
    display:block;
}

.toast.success{
    background:linear-gradient(
        135deg,
        #15803d,
        #16a34a
    );
    box-shadow:
        0 15px 35px rgba(22,163,74,.20);
}

.toast.error{
    background:linear-gradient(
        135deg,
        #b91c1c,
        #dc2626
    );
    box-shadow:
        0 15px 35px rgba(220,38,38,.20);
}
.app-only{
    display:none !important;
}

.app-only.app-visible{
    display:flex !important;
}
/* ================= MOBILE / PROFESSIONAL RESPONSIVE ================= */

.mobile-header{
    display:none;
}

.mobile-nav{
    display:none;
}

@media(max-width:1100px){

    .stats-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .nft-grid{
        grid-template-columns:repeat(2,1fr);
    }
}
/* ================= PROFESSIONAL MOBILE MENU ================= */

.mobile-menu{
    position:fixed !important;
    inset:0 !important;
    width:100% !important;
    height:100% !important;
    display:none !important;
    visibility:visible !important;
    opacity:1 !important;
    z-index:2147483647 !important;
}

.mobile-menu.show{
    display:block !important;
}

.mobile-menu-overlay{
    position:absolute;
    inset:0;
    background:rgba(0,0,0,.48);
    backdrop-filter:blur(5px);
    -webkit-backdrop-filter:blur(5px);
}

.mobile-menu-panel{
    position:absolute;
    top:0;
    right:0;
    width:min(88%,380px);
    height:100%;
    min-height:100vh;
    z-index:2;
    pointer-events:auto;
    background:#fff;
    display:flex;
    flex-direction:column;
}

.mobile-menu-overlay{
    position:absolute;
    inset:0;
    background:rgba(0,0,0,.48);
    backdrop-filter:blur(5px);
    -webkit-backdrop-filter:blur(5px);
}
.mobile-menu-panel{
    z-index:1000000 !important;
pointer-events:auto !important;
    position:absolute;
    top:0;
    right:0;
    width:min(88%,380px);
    height:100vh;
    min-height:100vh;
    background:
        linear-gradient(
            180deg,
            rgba(255,255,255,.99),
            rgba(248,247,255,.99)
        );
    border-left:1px solid rgba(108,77,246,.08);
    box-shadow:
        -18px 0 50px rgba(15,23,42,.16),
        -4px 0 14px rgba(108,77,246,.035);
    display:flex;
    flex-direction:column;
    animation:mobileMenuSlide .24s ease-out;
    backdrop-filter:blur(16px);
    -webkit-backdrop-filter:blur(16px);
}

@keyframes mobileMenuSlide{
    from{
        transform:translateX(100%);
    }
    to{
        transform:translateX(0);
    }
}
.mobile-menu-header{
    padding:20px 18px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:1px solid rgba(15,23,42,.07);
    background:rgba(255,255,255,.72);
}

.mobile-menu-header div{
    display:flex;
    flex-direction:column;
    gap:4px;
}

.mobile-menu-header strong{
    font-size:20px;
    line-height:1.25;
    font-weight:850;
    color:#111827;
    letter-spacing:-.25px;
}

.mobile-menu-header span{
    font-size:12px;
    line-height:1.4;
    color:#8a8f9c;
    font-weight:550;
}

.mobile-menu-header button{
    width:40px;
    height:40px;
    border:1px solid rgba(108,77,246,.09);
    border-radius:13px;
    background:linear-gradient(
        135deg,
        #f5f2ff,
        #eefaff
    );
    color:#555;
    font-size:24px;
    cursor:pointer;
    box-shadow:
        0 5px 14px rgba(15,23,42,.05);
    transition:
        transform .2s ease,
        box-shadow .2s ease,
        background .2s ease;
}

.mobile-menu-header button:active{
    transform:scale(.93);
}

.mobile-menu-items{
    flex:1;
    overflow-y:auto;
    padding:14px;
    scrollbar-width:thin;
    scrollbar-color:rgba(108,77,246,.20) transparent;
}

.mobile-menu-items button{
    width:100%;
    display:flex;
    align-items:center;
    gap:13px;
    padding:13px 12px;
    margin-bottom:9px;
    border:1px solid rgba(15,23,42,.065);
    border-radius:16px;
    background:rgba(255,255,255,.92);
    text-align:left;
    cursor:pointer;
    box-shadow:
        0 5px 16px rgba(15,23,42,.035);
    transition:
        transform .2s ease,
        background .2s ease,
        border-color .2s ease,
        box-shadow .2s ease;
}

.mobile-menu-items button:active{
    transform:scale(.98);
    background:#fafaff;
    border-color:rgba(108,77,246,.12);
}

.mobile-menu-items button > span{
    width:42px;
    height:42px;
    flex-shrink:0;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:12px;
    background:linear-gradient(
        135deg,
        #f1eeff,
        #eefaff
    );
    border:1px solid rgba(108,77,246,.07);
    color:var(--primary);
    font-size:19px;
    box-shadow:
        0 4px 12px rgba(108,77,246,.055);
}

.mobile-menu-items button div{
    display:flex;
    flex-direction:column;
    gap:3px;
    min-width:0;
}

.mobile-menu-items button strong{
    font-size:14px;
    line-height:1.3;
    font-weight:750;
    color:#171a21;
}

.mobile-menu-items button small{
    font-size:11px;
    line-height:1.35;
    color:#8a8f9c;
}

.mobile-menu-footer{
    padding:14px;
    border-top:1px solid rgba(15,23,42,.07);
    background:rgba(255,255,255,.72);
}

.mobile-menu-footer button{
    width:100%;
    height:48px;
    border:1px solid rgba(220,38,38,.10);
    border-radius:14px;
    background:linear-gradient(
        135deg,
        #fff5f5,
        #fff1f2
    );
    color:#dc2626;
    font-size:14px;
    font-weight:750;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:9px;
    cursor:pointer;
    box-shadow:
        0 5px 14px rgba(220,38,38,.045);
    transition:
        transform .2s ease,
        background .2s ease,
        box-shadow .2s ease;
}

.mobile-menu-footer button:active{
    transform:scale(.98);
}
@media(max-width:800px){

    .sidebar{
        display:none;
    }

    .main{
        margin-left:0;
        width:100%;
        padding-bottom:92px;
    }

    .topbar{
    padding:0 14px;
    min-height:64px;
    box-shadow:
        0 6px 20px rgba(15,23,42,.045);
}

    .content{
        padding:20px 14px 28px;
    }

    .mobile-header{
        display:block;
    }

   .nft-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:11px;
}

.my-nft-list{
    grid-template-columns:1fr;
    gap:14px;
}

    /* PREMIUM MOBILE BOTTOM BAR */
.mobile-nav{
    position:fixed;
    display:flex;
    left:8px;
    right:8px;
    bottom:8px;
    height:70px;
    padding:6px;
    background:rgba(255,255,255,.94);
    border:1px solid rgba(108,77,246,.10);
    border-radius:22px;
    box-shadow:
        0 16px 40px rgba(15,23,42,.14),
        0 5px 15px rgba(108,77,246,.06);
    z-index:200;
    justify-content:space-around;
    align-items:center;
    backdrop-filter:blur(18px);
    -webkit-backdrop-filter:blur(18px);
}

   .mobile-nav button{
    position:relative;
    min-width:55px;
    height:58px;
    padding:6px 7px;
    border:1px solid transparent;
    border-radius:16px;
    background:transparent;
    color:#7b8190;
    font-size:10px;
    font-weight:650;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:5px;
    cursor:pointer;
    transition:
        background .22s ease,
        color .22s ease,
        transform .22s ease,
        box-shadow .22s ease,
        border-color .22s ease;
    -webkit-tap-highlight-color:transparent;
}

.mobile-nav button:active{
    transform:scale(.93);
}

.mobile-nav button.active{
    color:var(--primary);
    background:linear-gradient(
        135deg,
        rgba(108,77,246,.12),
        rgba(6,182,212,.08)
    );
    border-color:rgba(108,77,246,.10);
    font-weight:800;
    box-shadow:
        0 6px 15px rgba(108,77,246,.07),
        inset 0 1px 0 rgba(255,255,255,.8);
}

.mobile-nav button.active::before{
    content:"";
    position:absolute;
    top:3px;
    width:24px;
    height:3px;
    border-radius:10px;
    background:linear-gradient(
        90deg,
        var(--primary),
        var(--cyan)
    );
    box-shadow:0 2px 7px rgba(108,77,246,.20);
}

.mobile-nav span{
    font-size:20px;
    line-height:1;
    transition:transform .22s ease;
}

.mobile-nav button.active span{
    transform:translateY(1px) scale(1.04);
}

    .welcome-card{
    border-radius:20px;
    box-shadow:
        0 12px 30px rgba(15,23,42,.08),
        0 4px 12px rgba(108,77,246,.035);
}

.welcome-card h1{
    font-size:22px;
    line-height:1.25;
    letter-spacing:-.3px;
}
    .balance-card{
    width:100%;
    min-width:0;
    border-radius:20px;
    padding:17px 18px;
    box-shadow:
        0 12px 30px rgba(15,23,42,.10),
        inset 0 1px 0 rgba(255,255,255,.18);
}
}

@media(max-width:550px){

    .stats-grid{
        grid-template-columns:1fr 1fr;
        gap:10px;
    }

    .stat-card{
    padding:15px 12px;
    border-radius:17px;
