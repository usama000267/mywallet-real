/* =====================================================
META NFT â€” PREMIUM PASSWORD SYSTEM
Modern / Colorful / Responsive
===================================================== */

.password-system {
width: 100%;
max-width: 520px;
margin: 25px auto;
padding: 2px;
border-radius: 28px;
background:
linear-gradient(
135deg,
#7c3aed,
#2563eb,
#06b6d4,
#ec4899
);
box-shadow:
0 25px 70px rgba(37, 99, 235, 0.25),
0 10px 30px rgba(124, 58, 237, 0.18);
}

.password-system-inner {
position: relative;
overflow: hidden;
border-radius: 26px;
padding: 32px 28px;
background:
linear-gradient(
145deg,
rgba(15, 23, 42, 0.98),
rgba(30, 41, 59, 0.97)
);
color: #ffffff;
}

.password-system-inner::before {
content: "";
position: absolute;
width: 180px;
height: 180px;
top: -90px;
right: -70px;
border-radius: 50%;
background: rgba(6, 182, 212, 0.22);
filter: blur(20px);
pointer-events: none;
}

.password-system-inner::after {
content: "";
position: absolute;
width: 160px;
height: 160px;
bottom: -80px;
left: -60px;
border-radius: 50%;
background: rgba(236, 72, 153, 0.20);
filter: blur(25px);
pointer-events: none;
}

/* =====================================================
HEADER
===================================================== */

.password-system-header {
position: relative;
z-index: 1;
text-align: center;
margin-bottom: 28px;
}

.password-system-icon {
width: 66px;
height: 66px;
margin: 0 auto 16px;
display: flex;
align-items: center;
justify-content: center;
border-radius: 20px;

background:
    linear-gradient(
        135deg,
        #8b5cf6,
        #3b82f6,
        #06b6d4
    );

box-shadow:
    0 12px 30px rgba(59, 130, 246, 0.35);

font-size: 29px;

}

.password-system-title {
margin: 0;
font-size: 27px;
font-weight: 800;
letter-spacing: -0.5px;

background:
    linear-gradient(
        90deg,
        #ffffff,
        #67e8f9,
        #c4b5fd,
        #f9a8d4
    );

-webkit-background-clip: text;
background-clip: text;
color: transparent;

}

.password-system-subtitle {
margin: 9px 0 0;
color: #94a3b8;
font-size: 14px;
line-height: 1.6;
}

/* =====================================================
FORM
===================================================== */

.password-system-form {
position: relative;
z-index: 1;
}

.password-system-field {
margin-bottom: 19px;
}

.password-system-label {
display: block;
margin-bottom: 8px;
color: #dbeafe;
font-size: 13px;
font-weight: 700;
}

.password-system-input-wrap {
position: relative;
}

.password-system-input {
width: 100%;
box-sizing: border-box;
padding: 14px 48px 14px 15px;
border: 1px solid rgba(148, 163, 184, 0.20);
border-radius: 14px;
outline: none;

background:
    rgba(15, 23, 42, 0.72);

color: #ffffff;
font-size: 15px;

transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;

}

.password-system-input::placeholder {
color: #64748b;
}

.password-system-input:focus {
border-color: #38bdf8;

background:
    rgba(15, 23, 42, 0.90);

box-shadow:
    0 0 0 3px rgba(56, 189, 248, 0.12),
    0 8px 25px rgba(14, 165, 233, 0.10);

}

.password-system-input[readonly] {
color: #94a3b8;
cursor: not-allowed;
background: rgba(51, 65, 85, 0.48);
}

/* =====================================================
EYE BUTTON
===================================================== */

.password-system-eye {
position: absolute;
top: 50%;
right: 13px;
transform: translateY(-50%);

border: 0;
background: transparent;
color: #94a3b8;

cursor: pointer;
font-size: 17px;

transition:
    color 0.2s ease,
    transform 0.2s ease;

}

.password-system-eye:hover {
color: #67e8f9;
transform:
translateY(-50%)
scale(1.08);
}

/* =====================================================
OTP
===================================================== */

.password-system-otp-row {
display: flex;
gap: 8px;
}

.password-system-otp {
flex: 1;
text-align: center;
letter-spacing: 5px;
font-size: 18px;
font-weight: 800;
}

.password-system-otp-button {
min-width: 112px;
border: 0;
border-radius: 14px;

background:
    linear-gradient(
        135deg,
        #8b5cf6,
        #3b82f6
    );

color: #ffffff;
font-weight: 800;
cursor: pointer;

box-shadow:
    0 10px 25px rgba(59, 130, 246, 0.22);

transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    opacity 0.2s ease;

}

.password-system-otp-button:hover {
transform: translateY(-2px);
box-shadow:
0 14px 32px rgba(59, 130, 246, 0.32);
}

.password-system-otp-button:disabled {
opacity: 0.55;
cursor: not-allowed;
transform: none;
}

/* =====================================================
MAIN BUTTON
===================================================== */

.password-system-submit {
width: 100%;
margin-top: 8px;
padding: 15px 18px;

border: 0;
border-radius: 15px;

background:
    linear-gradient(
        100deg,
        #7c3aed,
        #2563eb,
        #0891b2,
        #db2777
    );

background-size: 220% 100%;

color: #ffffff;
font-size: 15px;
font-weight: 900;
letter-spacing: 0.3px;

cursor: pointer;

box-shadow:
    0 14px 35px rgba(79, 70, 229, 0.28);

transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    background-position 0.5s ease;

}

.password-system-submit:hover {
transform: translateY(-2px);
background-position: 100% 0;

box-shadow:
    0 18px 42px rgba(79, 70, 229, 0.38);

}

.password-system-submit:active {
transform: translateY(0);
}

/* =====================================================
PASSWORD STRENGTH
===================================================== */

.password-system-strength {
display: flex;
gap: 5px;
margin-top: 9px;
}

.password-system-strength span {
flex: 1;
height: 4px;
border-radius: 10px;
background: #334155;
transition: background 0.25s ease;
}

.password-system-strength-text {
margin-top: 6px;
font-size: 11px;
color: #94a3b8;
}

/* =====================================================
STATUS MESSAGE
===================================================== */

.password-system-message {
display: none;
margin-bottom: 17px;
padding: 12px 14px;
border-radius: 13px;
font-size: 13px;
line-height: 1.5;
}

.password-system-message.success {
display: block;
color: #a7f3d0;
border: 1px solid rgba(16, 185, 129, 0.25);
background: rgba(16, 185, 129, 0.10);
}

.password-system-message.error {
display: block;
color: #fecaca;
border: 1px solid rgba(239, 68, 68, 0.25);
background: rgba(239, 68, 68, 0.10);
}

/* =====================================================
MOBILE
===================================================== */

@media (max-width: 600px) {

.password-system {
    margin: 15px 10px;
    border-radius: 23px;
}

.password-system-inner {
    padding: 26px 19px;
    border-radius: 21px;
}

.password-system-title {
    font-size: 23px;
}

.password-system-icon {
    width: 58px;
    height: 58px;
    font-size: 25px;
}

.password-system-otp-row {
    flex-direction: column;
}

.password-system-otp-button {
    width: 100%;
    min-height: 46px;
}

}
/* =========================================================
   META NFT â€” PREMIUM WHITE 4K THEME
   STEP 2
   Visual CSS only â€” functionality unchanged
   ========================================================= */

:root{
    --premium-primary:#6246ea;
    --premium-primary-2:#7c5cff;
    --premium-cyan:#06b6d4;
    --premium-text:#111827;
    --premium-muted:#73788c;
    --premium-border:rgba(17,24,39,.07);
    --premium-shadow:
        0 14px 40px rgba(17,24,39,.055),
        0 4px 12px rgba(98,70,234,.025);
}

/* ---------- GLOBAL PREMIUM SURFACE ---------- */

body{
    background:#f8f9fc;
    color:var(--premium-text);
}

.main{
    background:
        radial-gradient(
            circle at 10% 5%,
            rgba(98,70,234,.025),
            transparent 25%
        ),
        #f8f9fc;
}

.content{
    position:relative;
}

/* ---------- TOP BAR ---------- */

.topbar{
    background:rgba(255,255,255,.96);
    border-bottom:1px solid rgba(17,24,39,.06);
    box-shadow:
        0 8px 28px rgba(17,24,39,.045);
}

.topbar-title{
    color:#111827;
    letter-spacing:-.35px;
}

/* ---------- SIDEBAR ---------- */

.sidebar{
    background:
        linear-gradient(
            180deg,
            #ffffff 0%,
            #fbfbfe 100%
        );
    border-right:1px solid rgba(17,24,39,.06);
    box-shadow:
        8px 0 35px rgba(17,24,39,.035);
}

.sidebar-logo{
    border-bottom:1px solid rgba(17,24,39,.045);
    margin-bottom:14px;
}

.nav{
    gap:7px;
}

.nav-item{
    border-radius:14px;
    color:#697082;
}

.nav-item:hover{
    background:
        linear-gradient(
            135deg,
            rgba(98,70,234,.075),
            rgba(6,182,212,.045)
        );
    color:var(--premium-primary);
    transform:translateX(3px);
}

.nav-item.active{
    background:
        linear-gradient(
            135deg,
            rgba(98,70,234,.12),
            rgba(6,182,212,.055)
        );
    color:var(--premium-primary);
    border-color:rgba(98,70,234,.10);
    box-shadow:
        0 8px 20px rgba(98,70,234,.07),
        inset 0 1px 0 rgba(255,255,255,.9);
}

/* ---------- ALL CARDS ---------- */

.card,
.stat-card,
.nft-card,
.my-nft-card,
.form-card,
.profile-card{
    background:#fff;
    border:1px solid var(--premium-border);
    box-shadow:var(--premium-shadow);
}

.card:hover,
.stat-card:hover,
.nft-card:hover,
.my-nft-card:hover{
    border-color:rgba(98,70,234,.13);
    box-shadow:
        0 20px 48px rgba(17,24,39,.075),
        0 6px 18px rgba(98,70,234,.035);
}

/* ---------- SECTION HEADINGS ---------- */

.section-title{
    color:#111827;
    font-weight:850;
    letter-spacing:-.45px;
}

.section-subtitle{
    color:#858b9b;
}

/* ---------- PREMIUM BUTTONS ---------- */

.btn{
    border-radius:13px;
    position:relative;
    overflow:hidden;
}

.btn-primary{
    background:
        linear-gradient(
            135deg,
            #5f43e8,
            #7653f1 50%,
            #08aeca
        );
    background-size:180% 180%;
    box-shadow:
        0 10px 24px rgba(98,70,234,.17),
        0 3px 8px rgba(6,182,212,.07);
}

.btn-primary:hover{
    background-position:100% 50%;
    box-shadow:
        0 15px 32px rgba(98,70,234,.22),
        0 5px 14px rgba(6,182,212,.09);
}

.btn-secondary{
    background:
        linear-gradient(
            135deg,
            #f7f5ff,
            #f1fbff
        );
    color:#5141a8;
    border:1px solid rgba(98,70,234,.09);
}

/* ---------- PREMIUM INPUTS ---------- */

.form-control{
    background:#fafbfe;
    border:1px solid rgba(17,24,39,.085);
    border-radius:13px;
}

.form-control:hover{
    border-color:rgba(98,70,234,.18);
}

.form-control:focus{
    background:#fff;
    border-color:rgba(98,70,234,.48);
    box-shadow:
        0 0 0 4px rgba(98,70,234,.075),
        0 10px 25px rgba(17,24,39,.045);
}

/* ---------- DASHBOARD STATS ---------- */

.stat-card{
    position:relative;
    overflow:hidden;
}

.stat-card::before{
    content:"";
    position:absolute;
    top:0;
    left:0;
    right:0;
    height:3px;
    background:
        linear-gradient(
            90deg,
            var(--premium-primary),
            var(--premium-cyan)
        );
    opacity:.8;
}

.stat-title{
    color:#7b8190;
}

.stat-value{
    color:#111827;
}

/* ---------- NFT PREMIUM ---------- */

.nft-card{
    border-radius:22px;
}

.nft-image{
    background:
        linear-gradient(
            135deg,
            #f4f2ff,
            #eefaff
        );
}

.nft-body{
    background:#fff;
}

.nft-name{
    color:#111827;
}

.nft-price{
    color:#111827;
}

.nft-profit{
    background:
        linear-gradient(
            135deg,
            #effdf5,
            #e9fbf2
        );
    color:#15803d;
}

/* ---------- MY NFT ---------- */

.my-nft-card{
    border-radius:20px;
}

.my-nft-thumb{
    background:
        linear-gradient(
            135deg,
            #f4f1ff,
            #effaff
        );
}

/* ---------- DEPOSIT / WITHDRAW ---------- */

#page-deposit .form-card,
#page-withdraw .form-card{
    max-width:760px;
    border-radius:22px;
}

#page-deposit .section-head,
#page-withdraw .section-head{
    margin-bottom:22px;
}

#page-deposit .network-option,
#page-withdraw .network-option{
    border-radius:17px;
    background:
        linear-gradient(
            135deg,
            #ffffff,
            #faf9ff
        );
}

#page-deposit .network-option:hover,
#page-withdraw .network-option:hover{
    border-color:rgba(98,70,234,.20);
    box-shadow:
        0 12px 28px rgba(98,70,234,.075);
}

#page-deposit .network-option.selected,
#page-withdraw .network-option.selected{
    border-color:rgba(98,70,234,.42);
    background:
        linear-gradient(
            135deg,
            #f5f2ff,
            #effaff
        );
    box-shadow:
        0 12px 30px rgba(98,70,234,.10);
}

.address-box{
    background:
        linear-gradient(
            135deg,
            #faf9ff,
            #f3fbff
        );
    border-color:rgba(17,24,39,.075);
}

/* ---------- HISTORY ---------- */

.table-wrap{
    border-radius:20px;
    background:#fff;
    box-shadow:
        0 14px 38px rgba(17,24,39,.05);
}

table{
    background:#fff;
}

th{
    background:
        linear-gradient(
            135deg,
            #f8f7ff,
            #f3fbff
        );
    color:#697386;
}

td{
    background:#fff;
}

tbody tr:hover td{
    background:#fafaff;
}

/* ---------- REFERRAL ---------- */

.referral-card{
    border-radius:22px;
}

.referral-code{
    background:
        linear-gradient(
            135deg,
            #f5f2ff,
            #eefaff
        );
    border:1px dashed rgba(98,70,234,.40);
    color:#6046d8;
    box-shadow:
        0 8px 22px rgba(98,70,234,.055);
}

.referral-link input{
    background:#fafbfe;
}

/* ---------- PROFILE ---------- */

.profile-card{
    border-radius:22px;
}

.profile-avatar{
    background:
        linear-gradient(
            135deg,
            #6045e8,
            #08b0cc
        );
    box-shadow:
        0 12px 28px rgba(98,70,234,.18);
}

/* ---------- MODALS ---------- */

.modal{
    background:rgba(15,23,42,.42);
    backdrop-filter:blur(5px);
    -webkit-backdrop-filter:blur(5px);
}

.modal-box{
    border:1px solid rgba(255,255,255,.7);
    border-radius:23px;
    box-shadow:
        0 25px 80px rgba(15,23,42,.20);
}

/* ---------- MOBILE PREMIUM ---------- */

@media(max-width:800px){

    .content{
        background:#f8f9fc;
    }

    .topbar{
        background:rgba(255,255,255,.97);
    }

    .mobile-nav{
        background:rgba(255,255,255,.96);
        border:1px solid rgba(98,70,234,.09);
        box-shadow:
            0 18px 45px rgba(15,23,42,.14),
            0 5px 18px rgba(98,70,234,.055);
    }

    .welcome-card{
        box-shadow:
            0 15px 35px rgba(98,70,234,.13);
    }

    .form-card{
        box-shadow:
            0 12px 30px rgba(15,23,42,.055);
    }

}

/* ---------- PREMIUM MOTION ---------- */

@keyframes premiumFadeUp{
    from{
        opacity:0;
        transform:translateY(7px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

.page.active{
    animation:premiumFadeUp .28s ease-out;
}

/* ---------- REDUCE MOTION ---------- */

@media(prefers-reduced-motion:reduce){

    *,
    *::before,
    *::after{
        animation-duration:.01ms!important;
        animation-iteration-count:1!important;
        transition-duration:.01ms!important;
    }

}
</style>

</head>

<body>

<!-- ================= AUTH ================= -->

<div id="authPage" class="auth-page">

    <div class="auth-box">

        <div class="logo auth-logo">
            <div class="logo-icon">M</div>
            <span>Meta NFT</span>
        </div>

        <div id="loginFormBox">

            <h1 class="auth-title">Welcome Back</h1>
            <p class="auth-subtitle">Sign in to your Meta NFT account</p>

            <div id="loginMessage" class="auth-message"></div>

            <form id="loginForm">

                <div class="form-group">
                    <label>Email</label>
                    <input
                        id="loginEmail"
                        class="form-control"
                        type="email"
                        placeholder="Enter your email"
                        required
                    >
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input
                        id="loginPassword"
                        class="form-control"
                        type="password"
                        placeholder="Enter your password"
                        required
                    >
                </div>

                <button class="btn btn-primary btn-full" type="submit">
                    Login
                </button>

            </form>

            <div class="auth-switch">
                Don't have an account?
                <button type="button" onclick="showRegister()">
                    Create Account
                </button>
            </div>

        </div>

        <div id="registerFormBox" class="hidden">

            <h1 class="auth-title">Create Account</h1>
            <p class="auth-subtitle">Join Meta NFT today</p>

            <div id="registerMessage" class="auth-message"></div>

            <form id="registerForm">

                <div class="form-group">
                    <label>Full Name</label>
                    <input
                        id="registerName"
                        class="form-control"
                        type="text"
                        placeholder="Your full name"
                        required
                    >
                </div>

                <div class="form-group">
                    <label>Username</label>
                    <input
                        id="registerUsername"
                        class="form-control"
                        type="text"
                        placeholder="Choose username"
                    >
                </div>

            <div class="form-group register-email-group">
    <label>Email</label>

    <div class="register-email-row">

        <input
            id="registerEmail"
            class="form-control"
            type="email"
            placeholder="Enter email"
            required
        >

        <button
            type="button"
            
            id="registerSendOtpBtn"
            class="btn btn-primary"
            onclick="sendRegistrationOTP()"
            style="
                white-space:nowrap;
                min-width:110px;
            "
        >
            Send OTP
        </button>

    </div>
</div>

<div class="form-group">
    <label>Email Verification Code</label>

    <input
        id="registerOTP"
        class="form-control"
        type="text"
        inputmode="numeric"
        maxlength="6"
        placeholder="Enter 6-digit OTP"
        autocomplete="one-time-code"
    >

    <div
        id="registerOtpMessage"
        style="
            margin-top:7px;
            font-size:13px;
            color:#777;
        "
    ></div>
</div>

                <div class="form-group">
                    <label>Mobile</label>
                    <input
                        id="registerMobile"
                        class="form-control"
                        type="text"
                        placeholder="Mobile number"
                    >
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input
                        id="registerPassword"
                        class="form-control"
                        type="password"
                        placeholder="Create password"
                        required
                    >
                </div>

                <div class="form-group">
                    <label>Confirm Password</label>
                    <input
                        id="registerConfirmPassword"
                        class="form-control"
                        type="password"
                        placeholder="Confirm password"
                        required
                    >
                </div>

                <div class="form-group">
                    <label>Referral Code <span style="color:#999">(optional)</span></label>
                    <input
                        id="registerReferral"
                        class="form-control"
                        type="text"
                        placeholder="Referral code"
                    >
                </div>

                <button class="btn btn-primary btn-full" type="submit">
                    Create Account
                </button>

            </form>

            <div class="auth-switch">
                Already have an account?
                <button type="button" onclick="showLogin()">
                    Login
                </button>
            </div>

        </div>

    </div>

</div>


