}
}
#sendWithdrawOtpBtn{
    width:100%;
    min-height:46px;
    margin-top:4px;
    border-radius:13px;
    font-weight:800;
    box-shadow:
        0 8px 20px rgba(108,77,246,.08);
}

#sendWithdrawOtpBtn:disabled{
    opacity:.65;
    cursor:not-allowed;
    transform:none;
}
#depositForm .btn-primary{
    width:100%;
    min-height:48px;
    margin-top:4px;
    border-radius:13px;
    font-weight:800;
    box-shadow:
        0 9px 22px rgba(108,77,246,.15),
        0 3px 8px rgba(6,182,212,.06);
}

#depositForm .btn-primary:hover{
    transform:translateY(-2px);
}
#withdrawForm .btn-primary{
    width:100%;
    min-height:48px;
    margin-top:4px;
    border-radius:13px;
    font-weight:800;
    box-shadow:
        0 9px 22px rgba(108,77,246,.15),
        0 3px 8px rgba(6,182,212,.06);
}
#withdrawForm .btn-primary:hover{
    transform:translateY(-2px);
}

@media(max-width:550px){

    .section-title{
        font-size:20px;
        line-height:1.25;
        font-weight:850;
        letter-spacing:-.25px;
    }

    .section-subtitle{
        font-size:11px;
        line-height:1.45;
    }

}
.mobile-more-btn{
    position:relative !important;
    z-index:999999 !important;
    pointer-events:auto !important;
    cursor:pointer !important;
}
/* ================= MOBILE NFT PREMIUM ================= */

@media(max-width:550px){

    .nft-grid{
        grid-template-columns:repeat(2,minmax(0,1fr));
        gap:11px;
        width:100%;
    }

    .nft-card{
        border-radius:16px;
        border:1px solid rgba(15,23,42,.07);
        box-shadow:
            0 8px 20px rgba(15,23,42,.06),
            0 2px 7px rgba(108,77,246,.025);
    }

    .nft-image{
        height:145px;
    }

    .nft-body{
        padding:11px;
    }

    .nft-name{
        font-size:13px;
        line-height:1.3;
        font-weight:850;
        margin-bottom:6px;
    }

    .nft-price{
        font-size:15px;
        font-weight:850;
    }

    .nft-card .btn{
        width:100%;
        min-height:38px;
        font-size:11px;
        border-radius:10px;
        font-weight:800;
    }

}
/* ================= MOBILE NFT IMAGE QUALITY ================= */

@media(max-width:550px){

    .nft-image{
        background:#f4f6fb;
        overflow:hidden;
        display:flex;
        align-items:center;
        justify-content:center;
    }

    .nft-image img{
        width:100%;
        height:100%;
        object-fit:cover;
        object-position:center;
        display:block;
        image-rendering:auto;
        backface-visibility:hidden;
        -webkit-backface-visibility:hidden;
    }

}
/* ================= MOBILE NFT BUY BUTTON ================= */

@media(max-width:550px){

    .nft-card .btn-primary{
        width:100%;
        min-height:40px;
        padding:9px 8px;
        border-radius:11px;
        font-size:11px;
        font-weight:800;
        letter-spacing:.1px;
        box-shadow:
            0 7px 16px rgba(108,77,246,.16),
            0 2px 6px rgba(6,182,212,.06);
    }

    .nft-card .btn-primary:active{
        transform:scale(.97);
    }

}
/* ================= MOBILE MY NFT / SELL CARDS ================= */

@media(max-width:550px){

    .my-nft-list{
        grid-template-columns:1fr;
        gap:14px;
        width:100%;
    }

    .my-nft-row{
        width:100%;
        border-radius:17px;
        overflow:hidden;
        box-sizing:border-box;
        box-shadow:
            0 9px 24px rgba(15,23,42,.06),
            0 2px 8px rgba(108,77,246,.025);
    }

    .my-nft-thumb{
        width:100%;
        height:170px;
        object-fit:cover;
        object-position:center;
        display:block;
    }

}
/* ================= MOBILE FORM POLISH ================= */

@media(max-width:550px){

    .form-card{
        width:100%;
        padding:18px 14px;
        border-radius:18px;
        background:rgba(255,255,255,.985);
        border:1px solid rgba(15,23,42,.07);
        box-shadow:
            0 10px 26px rgba(15,23,42,.055),
            0 3px 9px rgba(108,77,246,.025);
        box-sizing:border-box;
    }

    .form-card .form-control{
        width:100%;
        min-height:45px;
        padding:11px 12px;
        border-radius:12px;
        font-size:12px;
        box-sizing:border-box;
    }

    .form-card .form-control:focus{
        box-shadow:
            0 0 0 3px rgba(108,77,246,.08),
            0 6px 16px rgba(15,23,42,.035);
    }

}
/* ================= MOBILE NETWORK OPTIONS ================= */

@media(max-width:550px){

    .network-grid{
        grid-template-columns:1fr 1fr;
        gap:9px;
        width:100%;
    }

    .network-option{
        min-height:70px;
        padding:12px 9px;
        border-radius:14px;
        background:
            linear-gradient(
                135deg,
                #ffffff,
                #f8f7ff
            );
        box-shadow:
            0 6px 16px rgba(15,23,42,.045);
    }

    .network-option.selected{
        border-color:rgba(108,77,246,.38);
        background:
            linear-gradient(
                135deg,
                #f1eeff,
                #eefaff
            );
        box-shadow:
            0 8px 19px rgba(108,77,246,.09),
            inset 0 1px 0 rgba(255,255,255,.85);
    }

    .network-option strong{
        font-size:12px;
        line-height:1.3;
    }

    .network-option span{
        font-size:10px;
        line-height:1.35;
        margin-top:5px;
    }

}
/* ================= MOBILE ADDRESS BOX ================= */

@media(max-width:550px){

    .address-box{
        width:100%;
