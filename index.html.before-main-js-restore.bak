        align-items:center;
        gap:7px;
        padding:6px;
        margin-bottom:16px;
        border-radius:14px;
        box-sizing:border-box;
    }

    .address-box input{
        flex:1;
        min-width:0;
        min-height:42px;
        padding:10px 9px;
        font-size:11px;
        font-weight:600;
        overflow:hidden;
        text-overflow:ellipsis;
        white-space:nowrap;
    }

    .copy-btn{
        flex-shrink:0;
        min-height:42px;
        padding:9px 11px;
        border-radius:11px;
        font-size:11px;
        font-weight:800;
    }

    .copy-btn:active{
        transform:scale(.96);
    }

}
/* ================= MOBILE HISTORY ================= */

@media(max-width:550px){

    #page-history .card{
        border-radius:17px;
        overflow:hidden;
    }

    #page-history .table-wrap{
        width:100%;
