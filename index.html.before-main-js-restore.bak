        min-width:48px;
        height:56px;
        padding:5px 4px;
        border-radius:15px;
        font-size:9px;
        font-weight:650;
        gap:4px;
    }

    .mobile-nav button.active{
        font-weight:800;
        box-shadow:
            0 5px 14px rgba(108,77,246,.07),
            inset 0 1px 0 rgba(255,255,255,.85);
    }

    .mobile-nav span{
        font-size:18px;
    }

    .mobile-nav button.active span{
        transform:translateY(1px) scale(1.05);
    }

}
