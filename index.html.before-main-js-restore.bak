        <div class="stat-value" id="ownedNFTs">
            0
        </div>
    </div>

</div>

</div>

            <!-- ================= MARKETPLACE ================= -->

            <section id="page-marketplace" class="page">

                <div class="section-head">

                    <div>
                        <div class="section-title">NFT Marketplace</div>
                        <div class="section-subtitle">
                            Browse and purchase available NFTs
                        </div>
                    </div>

                    <button class="btn btn-secondary" onclick="loadNFTs()">
                        Refresh
                    </button>

                </div>

                <div id="marketplaceGrid" class="nft-grid"></div>

            </section>


            <!-- ================= MY NFTS ================= -->

            <section id="page-my-nfts" class="page">

                <div class="section-head">

                    <div>
                        <div class="section-title">My NFTs</div>
                        <div class="section-subtitle">
                            NFTs currently owned by you
                        </div>
                    </div>

                    <button class="btn btn-secondary" onclick="loadMyNFTs()">
                        Refresh
                    </button>

                </div>

                <div id="myNFTsContainer" class="my-nft-list"></div>

            </section>


            <!-- ================= SELL ================= -->

            <section id="page-sell" class="page">

                <div class="section-head">
                    <div>
                        <div class="section-title">Sell NFT</div>
                        <div class="section-subtitle">
                            Sell one of your owned NFTs
                        </div>
                    </div>
                </div>

                <div id="sellNFTContainer" class="my-nft-list"></div>

            </section>


            <!-- ================= DEPOSIT ================= -->

            <section id="page-deposit" class="page">

                <div class="section-head">

                    <div>
                        <div class="section-title">Deposit</div>
                        <div class="section-subtitle">
                            Deposit USDT to your Meta NFT account
                        </div>
                    </div>

                </div>

                <div class="card form-card">

                    <div class="form-group">

                        <label>Select Network</label>

                        <div class="network-grid">

                            <button
                                type="button"
                                class="network-option selected"
                                id="depositBep20"
                                onclick="selectDepositNetwork('BEP20')"
                            >
                                <strong>USDT BEP20</strong>
                                <span>BNB Smart Chain</span>
                            </button>

                            <button
                                type="button"
                                class="network-option"
                                id="depositTrc20"
                                onclick="selectDepositNetwork('TRC20')"
                            >
                                <strong>USDT TRC20</strong>
                                <span>TRON Network</span>
                            </button>

                        </div>

                    </div>


                    <div class="form-group">

                        <label>Deposit Address</label>

                        <div class="address-box">

                            <input
                                id="depositAddress"
                                class="form-control"
                                type="text"
                                readonly
                                value="Loading..."
                            >

                            <button
                                class="btn btn-secondary copy-btn"
                                onclick="copyDepositAddress()"
                            >
                                Copy
                            </button>

                        </div>

                    </div>


                    <form id="depositForm">

                        <div class="form-group">
                            <label>Amount (USDT)</label>

                            <input
                                id="depositAmount"
                                class="form-control"
                                type="number"
                                step="0.01"
                                min="0.01"
                                placeholder="Enter amount"
                                required
                            >
                        </div>


                        <div class="form-group">
                            <label>Transaction Hash</label>

                            <input
                                id="depositTxHash"
                                class="form-control"
                                type="text"
                                placeholder="Enter blockchain transaction hash"
                                required
                            >
                        </div>


                        <button class="btn btn-primary" type="submit">
                            Submit Deposit
                        </button>

                    </form>

                </div>

            </section>


            <!-- ================= WITHDRAW ================= -->

            <section id="page-withdraw" class="page">

                <div class="section-head">

                    <div>
                        <div class="section-title">Withdraw</div>
                        <div class="section-subtitle">
                            Withdraw your available USDT balance
                        </div>
                    </div>

                </div>


                <div class="card form-card">

                    <form id="withdrawForm">

                        <div class="form-group">

                            <label>Select Network</label>

                            <div class="network-grid">

                                <button
                                    type="button"
                                    class="network-option selected"
                                    id="withdrawBep20"
                                    onclick="selectWithdrawNetwork('BEP20')"
                                >
                                    <strong>USDT BEP20</strong>
                                    <span>BNB Smart Chain</span>
                                </button>

                                <button
                                    type="button"
                                    class="network-option"
                                    id="withdrawTrc20"
                                    onclick="selectWithdrawNetwork('TRC20')"
                                >
                                    <strong>USDT TRC20</strong>
                                    <span>TRON Network</span>
                                </button>

                            </div>

                        </div>


                        <div class="form-group">

                            <label>Amount (USDT)</label>

                            <input
                                id="withdrawAmount"
                                class="form-control"
                                type="number"
                                step="0.01"
                                min="0.01"
                                placeholder="Enter amount"
                                required
                            >

                        </div>


                        <div class="form-group">

                            <label>Your Wallet Address</label>

                            <input
                                id="withdrawWalletAddress"
                                class="form-control"
                                type="text"
                                placeholder="Enter your USDT wallet address"
                                required
                            >

                        </div>
<!-- WITHDRAW OTP -->

<div class="form-group">

    <label>Email Verification OTP</label>

    <div style="display:flex; gap:10px;">

        <input
            id="withdrawOtp"
            class="form-control"
            type="text"
            inputmode="numeric"
            maxlength="6"
            placeholder="Enter 6-digit OTP"
        >

        <button
            type="button"
            class="btn btn-secondary"
            id="sendWithdrawOtpBtn"
            onclick="sendWithdrawOTP()"
        >
            Send OTP
        </button>

    </div>

    <div
        id="withdrawOtpMessage"
        style="
            margin-top:8px;
            font-size:12px;
            color:#777;
        "
    ></div>

</div>

                        <button class="btn btn-primary" type="submit">
                            Submit Withdrawal
                        </button>

                    </form>

                </div>

            </section>


            <!-- ================= HISTORY ================= -->

            <section id="page-history" class="page">

                <div class="section-head">

                    <div>
                        <div class="section-title">Transaction History</div>
                        <div class="section-subtitle">
                            Deposits, withdrawals and earnings
                        </div>
                    </div>

                    <button class="btn btn-secondary" onclick="loadHistory()">
                        Refresh
                    </button>

                </div>


                <div class="card">

                    <div class="table-wrap">

                        <table>

                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Network</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody id="historyTableBody"></tbody>

                        </table>

                    </div>

                </div>

            </section>


            <!-- ================= REFERRAL ================= -->

            <section id="page-referral" class="page">

                <div class="section-head">

                    <div>
                        <div class="section-title">Referral Program</div>
                        <div class="section-subtitle">
                            Invite users and earn referral bonuses
                        </div>
                    </div>

                </div>


                <div class="card referral-card">

                    <div style="color:#777;font-size:13px;">
                        Your Referral Code
                    </div>

                    <div class="referral-code" id="referralCode">
                        Loading...
                    </div>

                    <div style="color:#777;font-size:13px;margin-top:15px;">
                        Your Referral Link
                    </div>

                    <div class="referral-link">

                        <input
                            id="referralLink"
                            class="form-control"
                            type="text"
                            readonly
                        >

                        <button
                            class="btn btn-secondary"
                            onclick="copyReferralLink()"
                        >
                            Copy
                        </button>

                    </div>


                    <div class="stats-grid" style="margin-top:25px;margin-bottom:0;">

                        <div class="stat-card">
                            <div class="stat-title">
                                Bonus Percentage
                            </div>
                            <div class="stat-value" id="referralPercent">
                                10%
                            </div>
                        </div>

                        <div class="stat-card">
                            <div class="stat-title">
                                Team Members
                            </div>
                            <div class="stat-value" id="teamCount">
                                0
                            </div>
                        </div>

                        <div class="stat-card">
                            <div class="stat-title">
                                Total Bonus
                          </div>
                            <div class="stat-value" id="totalReferralBonus">
                                $0.00
                            </div>
                        </div>

                    </div>

                </div>


                <!-- ================= REFERRAL HISTORY ================= -->
